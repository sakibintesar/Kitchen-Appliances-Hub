---
import Layout from '../../layouts/Layout.astro';

const orderId = Astro.params.id;
let orderData: any = null;
let error: string | null = null;

if (orderId) {
  try {
    const res = await fetch(`${Astro.request.url.split('/orders')[0]}/api/orders/${orderId}`);
    if (res.ok) {
      orderData = await res.json();
    } else if (res.status === 404) {
      error = 'Order not found';
    } else {
      error = 'Failed to load order details';
    }
  } catch (e) {
    console.error('Failed to fetch order:', e);
    error = 'Network error. Please try again.';
  }
}

function fmtBDT(n: number) {
  return '৳' + (n / 100).toLocaleString('en-BD', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function getStatusBadge(status: string) {
  const badges: Record<string, { label: string; class: string }> = {
    pending: { label: 'Pending Payment', class: 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300' },
    pending_payment: { label: 'Pending Payment', class: 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300' },
    confirmed: { label: 'Confirmed', class: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300' },
    processing: { label: 'Processing', class: 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300' },
    shipped: { label: 'Shipped', class: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/30 dark:text-indigo-300' },
    delivered: { label: 'Delivered', class: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300' },
    cancelled: { label: 'Cancelled', class: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300' },
    refunded: { label: 'Refunded', class: 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300' },
    failed: { label: 'Payment Failed', class: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300' },
    payment_failed: { label: 'Payment Failed', class: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300' },
    validated: { label: 'Validated', class: 'bg-teal-100 text-teal-800 dark:bg-teal-900/30 dark:text-teal-300' },
  };
  return badges[status] || { label: status, class: 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300' };
}

function formatDate(timestamp: number) {
  return new Date(timestamp * 1000).toLocaleDateString('en-BD', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<Layout title={`Order ${orderId} — KitchenHub`} description={`View details for order ${orderId}`}>
  <main class='mx-auto max-w-3xl px-5 py-12 sm:py-16'>
    <div class='space-y-8'>
      <div>
        <h1 class='font-display text-[clamp(28px,4vw,40px)] font-extrabold tracking-tight text-ink'>
          Order Details
        </h1>
        <p class='mt-2 text-muted'>{orderId ? `Order #${orderId}` : 'Order not found'}</p>
      </div>

      {error && (
        <div class='rounded-2xl border border-red-200 bg-red-50 p-6 text-center dark:border-red-900/30 dark:bg-red-900/20'>
          <svg class='mx-auto h-12 w-12 text-red-500' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z' />
          </svg>
          <p class='mt-3 text-lg font-medium text-red-800 dark:text-red-200'>{error}</p>
          <p class='mt-2 text-sm text-red-600 dark:text-red-400'>
            The order you're looking for doesn't exist or has been removed.
          </p>
          <a href='/account/orders' class='mt-4 inline-flex items-center gap-2 rounded-xl bg-red-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-red-700 transition focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:ring-offset-2 dark:focus:ring-offset-gray-900'>
            View All Orders
          </a>
        </div>
      )}
{orderData && !error && (
        <>
          <div class='rounded-2xl border border-line bg-paper/90 p-6'>
            <div class='flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4'>
              <div>
                <div class='flex items-center gap-3'>
                  <span class={`
                    inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold
                    ${getStatusBadge(orderData.status).class}
                  `}>
                    {getStatusBadge(orderData.status).label}
                  </span>
                  {orderData.paymentMethod && (
                    <span class='inline-flex items-center rounded-full border border-line bg-paper px-3 py-1 text-sm font-medium text-muted'>
                      {orderData.paymentMethod === 'cod' ? 'Cash on Delivery' : orderData.paymentMethod.toUpperCase()}
                    </span>
                  )}
                </div>
                <p class='mt-2 text-sm text-muted'>Placed on {formatDate(orderData.created_at)}</p>
              </div>
              <div class='text-right sm:text-right'>
                <p class='font-display text-3xl font-extrabold text-ink'>{fmtBDT(orderData.totalAmount)}</p>
                <p class='text-sm text-muted'>Order Total</p>
              </div>
            </div>
          </div>

          <div class='rounded-2xl border border-line bg-paper/90 overflow-hidden'>
            <div class='border-b border-line px-6 py-4'>
              <h2 class='font-heading text-lg font-semibold text-ink'>Order Items</h2>
            </div>
            <div class='divide-y divide-line'>
              {(orderData.lines || []).map((item: any) => (
                <div class='flex flex-col sm:flex-row sm:items-center gap-4 p-4'>
                  <div class='flex items-center gap-4 flex-shrink-0'>
                    {item.image && (
                      <img src={item.image} alt={item.title} class='h-16 w-16 rounded-lg object-cover border border-line' />
                    )}
                    <div>
                      <p class='font-medium text-ink'>{item.title}</p>
                      {item.variantTitle && <p class='text-sm text-muted'>{item.variantTitle}</p>}
                    </div>
                  </div>
                  <div class='flex-1 flex sm:items-center sm:justify-between gap-2'>
                    <div class='flex items-center gap-4'>
                      <span class='text-sm text-muted'>Qty: {item.quantity}</span>
                      <span class='font-medium text-ink'>{fmtBDT((item.price?.amount || 0) * (item.quantity || 1))}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class='rounded-2xl border border-line bg-paper/90 p-6'>
            <h2 class='font-heading text-lg font-semibold text-ink'>Order Summary</h2>
            <dl class='mt-4 space-y-3 text-sm'>
              <div class='flex justify-between'>
                <dt class='text-muted'>Subtotal</dt>
                <dd class='font-medium text-ink'>{fmtBDT(orderData.totalAmount - (orderData.shippingAmount || 0) - (orderData.taxAmount || 0))}</dd>
              </div>
              <div class='flex justify-between'>
                <dt class='text-muted'>Shipping</dt>
                <dd class='font-medium text-ink'>{fmtBDT(orderData.shippingAmount || 0)}</dd>
              </div>
              <div class='flex justify-between'>
                <dt class='text-muted'>Tax (VAT)</dt>
                <dd class='font-medium text-ink'>{fmtBDT(orderData.taxAmount || 0)}</dd>
              </div>
              {orderData.paymentMethod === 'cod' && (
                <div class='flex justify-between'>
                  <dt class='text-muted'>COD Fee</dt>
                  <dd class='font-medium text-ink'>{fmtBDT(500)}</dd>
                </div>
              )}
              <div class='border-t border-line pt-3 flex justify-between'>
                <dt class='font-semibold text-ink'>Total</dt>
                <dd class='font-display text-xl font-extrabold text-ink'>{fmtBDT(orderData.totalAmount)}</dd>
              </div>
            </dl>
          </div>
{orderData.shipping_address && (
            <div class='rounded-2xl border border-line bg-paper/90 p-6'>
              <h2 class='font-heading text-lg font-semibold text-ink'>Shipping Address</h2>
              <address class='mt-3 not-italic text-sm text-muted'>
                <p>{orderData.name}</p>
                {orderData.phone && <p>Phone: {orderData.phone}</p>}
                {orderData.shipping_address.address1 && <p>{orderData.shipping_address.address1}</p>}
                {orderData.shipping_address.address2 && <p>{orderData.shipping_address.address2}</p>}
                <p>
                  {orderData.shipping_address.city}
                  {orderData.shipping_address.state && `, ${orderData.shipping_address.state}`}
                  {orderData.shipping_address.zip && ` ${orderData.shipping_address.zip}`}
                </p>
                <p>{orderData.shipping_address.country}</p>
              </address>
            </div>
          )}

          {orderData.billing_address && orderData.billing_address.address1 !== orderData.shipping_address?.address1 && (
            <div class='rounded-2xl border border-line bg-paper/90 p-6'>
              <h2 class='font-heading text-lg font-semibold text-ink'>Billing Address</h2>
              <address class='mt-3 not-italic text-sm text-muted'>
                <p>{orderData.name}</p>
                {orderData.billing_address.address1 && <p>{orderData.billing_address.address1}</p>}
                {orderData.billing_address.address2 && <p>{orderData.billing_address.address2}</p>}
                <p>
                  {orderData.billing_address.city}
                  {orderData.billing_address.state && `, ${orderData.billing_address.state}`}
                  {orderData.billing_address.zip && ` ${orderData.billing_address.zip}`}
                </p>
                <p>{orderData.billing_address.country}</p>
              </address>
            </div>
          )}

          <div class='rounded-2xl border border-line bg-paper/90 p-6'>
            <h2 class='font-heading text-lg font-semibold text-ink'>Payment Information</h2>
            <dl class='mt-4 space-y-3 text-sm'>
              <div class='flex justify-between'>
                <dt class='text-muted'>Payment Method</dt>
                <dd class='font-medium text-ink'>{orderData.paymentMethod === 'cod' ? 'Cash on Delivery' : orderData.paymentMethod?.toUpperCase() || 'N/A'}</dd>
              </div>
              {orderData.payment_intent_id && (
                <div class='flex justify-between'>
                  <dt class='text-muted'>Transaction ID</dt>
                  <dd class='font-mono text-sm text-ink break-all'>{orderData.payment_intent_id}</dd>
                </div>
              )}
              {orderData.tran_id && (
                <div class='flex justify-between'>
                  <dt class='text-muted'>SSLCommerz Tran ID</dt>
                  <dd class='font-mono text-sm text-ink break-all'>{orderData.tran_id}</dd>
                </div>
              )}
            </dl>
          </div>

          <div class='flex flex-col sm:flex-row items-center justify-center gap-4'>
            <a href='/account/orders' class='w-full sm:w-auto rounded-xl border border-line bg-paper px-6 py-3.5 text-center text-sm font-semibold text-ink hover:border-ink/50 transition focus:outline-none focus:ring-2 focus:ring-ink/50 focus:ring-offset-2'>
              View All Orders
            </a>
            <a href='/collections' class='w-full sm:w-auto rounded-xl bg-ink px-6 py-3.5 text-center text-sm font-semibold text-paper hover:bg-ink/90 transition focus:outline-none focus:ring-2 focus:ring-ink/50 focus:ring-offset-2'>
              Continue Shopping
            </a>
          </div>
        </>
      )}
    </div>
  </main>
</Layout>
