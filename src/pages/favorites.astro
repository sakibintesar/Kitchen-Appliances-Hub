---
// Favorites page — the list lives in localStorage, so the grid renders
// client-side from the product index Layout already puts on <body>.
import Layout from '../layouts/Layout.astro';
import { FAVORITES_PAGE as T } from '../constants/pages';
---

<Layout title={T.meta.title} description={T.meta.description}>
  <section class="mx-auto max-w-6xl px-5 pb-4 sm:pb-8 pt-6">
    <h1 class="font-display text-[clamp(32px,5vw,52px)] font-extrabold tracking-tight">{T.title}</h1>
    <p data-fav-sub class="mt-3 text-[16px] text-muted">{T.subEmpty}</p>

    <div data-fav-grid class="mt-8 hidden grid-cols-2 gap-x-5 gap-y-5 md:grid-cols-4"></div>

    <div data-fav-empty class="hidden py-10 text-center sm:py-16">
      <p class="text-4xl">{T.empty.icon}</p>
      <p class="mt-3 text-[16px] font-medium">{T.empty.title}</p>
      <p class="mt-1 text-[14px] text-muted">{T.empty.text}</p>
      <a href={T.empty.cta.href} class="mt-6 inline-block rounded-md bg-pine px-6 py-3.5 text-[15px] font-semibold text-white hover:bg-pine-deep">
        {T.empty.cta.label}
      </a>
    </div>
  </section>

  <script>
    import { favorites } from '../lib/favorites';
    import { FAVORITES_PAGE as T } from '../constants/pages';

    const index: { handle: string; title: string; price: number; image: string }[] =
      JSON.parse(document.body.dataset.searchIndex!);
    const grid = document.querySelector<HTMLElement>('[data-fav-grid]')!;
    const empty = document.querySelector<HTMLElement>('[data-fav-empty]')!;
    const sub = document.querySelector<HTMLElement>('[data-fav-sub]')!;

    function render() {
      const list = favorites.get();
      const items = index.filter((p) => list.includes(p.handle));
      grid.classList.toggle('hidden', items.length === 0);
      grid.classList.toggle('grid', items.length > 0);
      empty.classList.toggle('hidden', items.length > 0);
      sub.textContent = items.length ? T.subCount(items.length) : T.subEmpty;
      grid.innerHTML = items
        .map(
          (p) => `
          <a href="/products/${p.handle}" class="group block rounded-lg transition hover:bg-tile/60">
            <div class="relative overflow-hidden rounded-lg bg-tile">
              <img src="${p.image}" alt="${p.title}" class="aspect-square w-full object-cover transition duration-300 group-hover:scale-[1.03]" loading="lazy"/>
              <button type="button" data-fav-toggle="${p.handle}" onclick="event.preventDefault()"
                class="is-fav absolute right-3 top-3 rounded-md bg-paper/85 p-2 text-ink shadow-sm backdrop-blur transition hover:text-pine"
                aria-label="${T.ariaRemove(p.title)}">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20.5c-5.5-3.6-8.5-6.9-8.5-10.4A4.6 4.6 0 0 1 8.1 5.4c1.6 0 3 .8 3.9 2.1a4.7 4.7 0 0 1 3.9-2.1 4.6 4.6 0 0 1 4.6 4.7c0 3.5-3 6.8-8.5 10.4z"/>
                </svg>
              </button>
            </div>
            <div class="flex flex-col items-center justify-center gap-2 px-4 py-3">
              <h3 class="truncate text-[15px] font-medium group-hover:underline group-hover:underline-offset-4">${p.title}</h3>
              <p class="text-[18px] text-muted">$${p.price}</p>
            </div>
          </a>`,
        )
        .join('');
    }

    favorites.subscribe(render);
    render();
  </script>
</Layout>
