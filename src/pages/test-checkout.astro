---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Test Checkout">
  <main>
    <h1>Test Checkout</h1>
    <div class="mt-8 lg:grid lg:grid-cols-12 lg:gap-8">
      <section class="lg:col-span-7 space-y-6">
        <form class="space-y-6" novalidate>
          <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
            <h3>Contact Information</h3>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <div>
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required />
              </div>
            </div>
          </div>
          <div class="hidden space-y-6">
            <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
              <h3>Shipping Address</h3>
            </div>
          </div>
          <div class="hidden space-y-6">
            <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
              <h3>Payment Method</h3>
            </div>
          </div>
          <div class="hidden space-y-6">
            <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
              <h3>Review</h3>
            </div>
          </div>
          <div class="flex items-center justify-between pt-4 border-t border-line">
            <button type="button">Back</button>
            <div class="flex items-center gap-3">
              <button type="button">Continue</button>
              <button type="submit">Place Order</button>
            </div>
          </div>
        </form>
      </section>
      <aside class="lg:col-span-5">
        <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
          <h2>Order Summary</h2>
        </div>
      </aside>
    </div>
  </main>
</Layout>