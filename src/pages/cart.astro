---
import Layout from '../layouts/Layout.astro';
import { CART as T } from '../constants/components';
import { Image } from 'astro:assets';
---

<Layout title="Shopping Cart — KitchenHub" description="Review your cart and proceed to checkout.">
  <main class="mx-auto max-w-6xl px-5 py-8 sm:py-12" data-cart-page>
    <h1 class="font-display text-[clamp(28px,4vw,40px)] font-extrabold tracking-tight">{T.title}</h1>

    <div class="mt-8 lg:grid lg:grid-cols-12 lg:gap-8">
      <!-- Cart Items -->
      <section class="lg:col-span-8" aria-labelledby="cart-items-heading">
        <h2 id="cart-items-heading" class="sr-only">Cart items</h2>
        
        <div class="rounded-2xl border border-line bg-paper/90 overflow-hidden" data-cart-items>
          <!-- Empty state -->
          <div data-empty class="hidden py-16 text-center">
            <svg class="mx-auto h-16 w-16 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <p class="mt-4 text-lg text-muted">{T.emptyCart}</p>
            <a href="/collections/cooking" class="mt-6 inline-flex items-center gap-2 rounded-md bg-ink px-5 py-3 text-sm font-semibold text-paper hover:bg-ink/90">
              {T.continueShopping}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <!-- Cart items list (populated by client-side JS) -->
          <div data-cart-list class="divide-y divide-line"></div>
        </div>

        <!-- Promo code -->
        <div class="mt-6 rounded-2xl border border-line bg-paper/90 p-5">
          <div class="flex flex-wrap items-center gap-3">
            <label for="promo-code" class="font-medium text-ink">{T.promoLabel}</label>
            <div class="flex-1 flex gap-2 min-w-[200px]">
              <input
                type="text"
                id="promo-code"
                placeholder={T.promoPlaceholder}
                class="flex-1 rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20"
                aria-label={T.promoLabel}
              />
              <button
                type="button"
                class="rounded-md border border-line bg-paper px-5 py-2.5 text-sm font-medium text-ink hover:border-ink hover:text-ink transition"
                data-apply-promo
              >
                {T.applyPromo}
              </button>
            </div>
            <p data-promo-message class="hidden text-sm text-pine"></p>
          </div>
        </div>

        <!-- Continue shopping -->
        <div class="mt-6">
          <a href="/collections/cooking" class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-ink transition">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            {T.continueShopping}
          </a>
        </div>
      </section>

      <!-- Order Summary -->
      <aside class="mt-8 lg:mt-0 lg:col-span-4 lg:self-start lg:sticky lg:top-24" aria-labelledby="summary-heading">
        <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
          <h2 id="summary-heading" class="font-display text-lg font-bold">{T.orderSummary}</h2>

          <dl class="mt-4 space-y-3 text-sm" data-summary-lines>
            <div class="flex justify-between">
              <dt class="text-muted">{T.subtotal}</dt>
              <dd class="font-medium text-ink" data-subtotal>$0.00</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">{T.shipping}</dt>
              <dd class="font-medium text-ink" data-shipping>{T.shippingCalculated}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">{T.tax}</dt>
              <dd class="font-medium text-ink" data-tax>{T.taxCalculated}</dd>
            </div>
            <div class="flex justify-between border-t border-line pt-3">
              <dt class="font-bold text-ink">{T.total}</dt>
              <dd class="font-bold text-ink text-lg" data-total>$0.00</dd>
            </div>
          </dl>

          <p class="mt-4 text-xs text-muted text-center">{T.shippingTaxNote}</p>

          <button
            type="button"
            class="mt-6 w-full rounded-md bg-ink px-5 py-3.5 text-base font-semibold text-paper hover:bg-ink/90 transition disabled:opacity-50 disabled:cursor-not-allowed"
            data-checkout
            disabled
          >
            {T.checkout}
          </button>

          <p class="mt-4 text-center text-xs text-muted">{T.secureCheckout}</p>

          <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
            <img src="/payments/visa.svg" alt="Visa" class="h-5 opacity-60" />
            <img src="/payments/mastercard.svg" alt="Mastercard" class="h-5 opacity-60" />
            <img src="/payments/ssl-commerce.svg" alt="SSL Commerce" class="h-5 opacity-60" />
            <img src="/payments/bkash.svg" alt="bKash" class="h-5 opacity-60" />
            <img src="/payments/nagad.svg" alt="Nagad" class="h-5 opacity-60" />
          </div>
        </div>
      </aside>
    </div>
  </main>
<script>
    import { cartLines, setQuantity } from '../lib/cart';
    const cartList = document.querySelector('[data-cart-list]');
    const emptyState = document.querySelector('[data-empty]');
    const subtotalEl = document.querySelector('[data-subtotal]');
    const totalEl = document.querySelector('[data-total]');
    const checkoutBtn = document.querySelector('[data-checkout]');
    const promoInput = document.querySelector('[data-promo-code]');
    const applyPromoBtn = document.querySelector('[data-apply-promo]');
    const promoMessage = document.querySelector('[data-promo-message]');
    const SHIPPING_THRESHOLD = 500, SHIPPING_COST = 15, TAX_RATE = 0.08;
    let promoDiscount = 0;
function renderCart() {
      const lines = cartLines.get();
      if (lines.length === 0) { cartList.innerHTML = ''; emptyState.classList.remove('hidden'); checkoutBtn.disabled = true; updateTotals(0); return; }
      emptyState.classList.add('hidden'); checkoutBtn.disabled = false;
      cartList.innerHTML = lines.map((line, i) => `
        <div class="flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:gap-5" data-cart-item data-variant-id="${line.variantId}" data-index="${i}">
          <div class="relative h-24 w-24 shrink-0 rounded-lg overflow-hidden bg-tile sm:h-28 sm:w-28">${line.image ? `<img src="${line.image.src}" alt="${line.image.alt}" class="h-full w-full object-cover" loading="lazy"/>` : `<div class="h-full w-full flex items-center justify-center text-muted"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 17"/></svg></div>`}</div>
          <div class="flex-1 min-w-0"><div class="flex flex-wrap items-start justify-between gap-2"><div><h3 class="font-medium text-ink line-clamp-1">${line.title}</h3>${line.variantTitle && line.variantTitle !== 'Default' ? `<p class="mt-0.5 text-sm text-muted">${line.variantTitle}</p>` : ''}</div><button type="button" class="shrink-0 rounded-md p-1.5 text-muted hover:text-ink hover:bg-line/50 transition" data-remove aria-label="Remove ${line.title}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg></button></div><div class="mt-3 flex items-center gap-4"><div class="flex items-center gap-2 rounded-md border border-line"><button type="button" class="px-3 py-1.5 text-sm font-medium text-ink hover:bg-line/50 transition" data-qty-decrease aria-label="Decrease quantity">−</button><span class="w-10 text-center text-sm font-medium text-ink" data-qty>${line.quantity}</span><button type="button" class="px-3 py-1.5 text-sm font-medium text-ink hover:bg-line/50 transition" data-qty-increase aria-label="Increase quantity">+</button></div><span class="font-medium text-ink" data-line-total>${formatMoney(line.price.amount * line.quantity, line.price.currency)}</span></div></div></div>
      `).join('');
      attachItemListeners();
      const subtotal = lines.reduce((s, l) => s + l.price.amount * l.quantity, 0);
      updateTotals(subtotal);
    }
    function attachItemListeners() {
      document.querySelectorAll('[data-cart-item]').forEach(item => {
        const variantId = item.dataset.variantId, qtyEl = item.querySelector('[data-qty]');
        item.querySelector('[data-qty-decrease]')?.addEventListener('click', () => { const c = parseInt(qtyEl.textContent || '1', 10); if (c > 1) setQuantity(variantId, c - 1); });
        item.querySelector('[data-qty-increase]')?.addEventListener('click', () => { const c = parseInt(qtyEl.textContent || '1', 10); setQuantity(variantId, c + 1); });
        item.querySelector('[data-remove]')?.addEventListener('click', () => setQuantity(variantId, 0));
      });
    }
function updateTotals(subtotal) {
      const discount = promoDiscount, after = Math.max(0, subtotal - discount), shipping = after >= SHIPPING_THRESHOLD ? 0 : SHIPPING_COST, tax = after * TAX_RATE, total = after + shipping + tax;
      subtotalEl.textContent = formatMoney(subtotal, 'USD');
      document.querySelector('[data-shipping]').textContent = shipping === 0 ? 'FREE' : formatMoney(shipping, 'USD');
      document.querySelector('[data-tax]').textContent = formatMoney(tax, 'USD');
      totalEl.textContent = formatMoney(total, 'USD');
    }
    function formatMoney(a, c = 'USD') { return new Intl.NumberFormat('en-US', { style: 'currency', currency: c }).format(a / 100); }
    renderCart(); cartLines.subscribe(renderCart);
    const PROMO_CODES = { 'WELCOME10': { type: 'percent', value: 10, message: '10% off applied!' }, 'SAVE50': { type: 'fixed', value: 5000, message: '$50 off applied!' }, 'FREESHIP': { type: 'shipping', value: 0, message: 'Free shipping applied!' } };
    applyPromoBtn?.addEventListener('click', () => { const code = promoInput?.value.trim().toUpperCase(); if (!code) return; const p = PROMO_CODES[code]; if (p) { if (p.type === 'percent') { const l = cartLines.get(), s = l.reduce((s, x) => s + x.price.amount * x.quantity, 0); promoDiscount = Math.round(s * (p.value / 100)); } else if (p.type === 'fixed') promoDiscount = p.value; else promoDiscount = 0; promoMessage.textContent = p.message; promoMessage.classList.remove('hidden', 'text-red-500'); promoMessage.classList.add('text-pine'); renderCart(); } else { promoMessage.textContent = 'Invalid promo code'; promoMessage.classList.remove('hidden', 'text-pine'); promoMessage.classList.add('text-red-500'); } });
    checkoutBtn?.addEventListener('click', async () => { const l = cartLines.get(); if (!l.length) return; checkoutBtn.disabled = true; checkoutBtn.textContent = 'Redirecting...'; try { window.location.href = '/checkout?mock=true'; } catch (e) { console.error('Checkout error:', e); checkoutBtn.disabled = false; checkoutBtn.textContent = 'Proceed to Checkout'; } });
  </script>
</Layout>