---
import Layout from '../layouts/Layout.astro';
import { PRIVACY as T } from '../constants/pages';
---

<Layout title={T.meta.title} description={T.meta.description}>
  <section class="mx-auto max-w-3xl px-5 pb-8 sm:pb-16 pt-6 sm:pt-12">
    <h1 class="font-display text-[clamp(32px,4vw,48px)] font-extrabold tracking-tight">{T.title}</h1>
    <p class="mt-2 text-[13px] text-muted">{T.updated}</p>

    <div class="mt-8 space-y-6 text-[15px] leading-relaxed text-muted">
      {T.sections.map((s) => (
        <div>
          <h2 class="mb-2 font-display text-lg font-bold text-ink">{s.h}</h2>
          <p>{s.p}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
