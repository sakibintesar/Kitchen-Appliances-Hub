---
import Layout from '../layouts/Layout.astro'
import { CART as T } from '../constants/components'

interface Props {
  mock?: string;
}

const { mock = 'false' } = Astro.props;
const isMock = mock === 'true';

const checkoutSteps = [
  { id: 'info', label: 'Contact Info', icon: 'M16 12a4 4 0 10-8 0 4 4 0 008 0z', step: 1 },
  { id: 'shipping', label: 'Shipping', icon: 'M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4', step: 2 },
  { id: 'payment', label: 'Payment', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z', step: 3 },
  { id: 'review', label: 'Review', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', step: 4 },
];

---

<Layout title="Checkout — KitchenHub" description="Complete your purchase securely.">
  <main class="mx-auto max-w-6xl px-5 py-8 sm:py-12" data-checkout-page>
    <h1 class="font-display text-[clamp(28px,4vw,40px)] font-extrabold tracking-tight">Checkout</h1>

    <nav class="mt-6 hidden md:flex items-center justify-between" aria-label="Checkout progress">
      {checkoutSteps.map((step, idx) => (
        <div class="relative flex-1" key={step.id}>
          {idx > 0 ? <div class="absolute left-0 top-3 w-full h-0.5 bg-line z-0"></div> : null}
          <div class="relative z-10 flex flex-col items-center gap-2">
            <div class={`flex h-6 w-6 items-center justify-center rounded-full border-2 text-sm font-semibold transition-all ${step.step === 1 ? 'bg-ink border-ink text-paper' : 'bg-paper border-line text-muted'}`} data-step={step.step}>
              {step.step === 1 && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>}
              {step.step > 1 && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d={step.icon}/></svg>}
            </div>
            <span class="text-xs font-medium text-muted">{step.label}</span>
          </div>
        </div>
      ))}
    </nav>
<div class="mt-8 lg:grid lg:grid-cols-12 lg:gap-8">
      <section class="lg:col-span-7 space-y-6" aria-labelledby="checkout-form-heading">
        <h2 id="checkout-form-heading" class="sr-only">Checkout form</h2>

        <form data-step-form="1" class="space-y-6" novalidate>
          <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
            <h3 class="font-heading text-lg font-semibold text-ink">Contact Information</h3>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <div>
                <label for="email" class="block text-sm font-medium text-ink mb-1">Email <span class="text-red-500">*</span></label>
                <input type="email" id="email" name="email" required autoComplete="email"
                  class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20"
                  placeholder="you@example.com" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-ink mb-1">Phone (optional)</label>
                <input type="tel" id="phone" name="phone" autoComplete="tel"
                  class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20"
                  placeholder="+1 (555) 000-0000" />
              </div>
            </div>
            <p class="mt-4 text-sm text-muted">We'll send order updates to this email.</p>
          </div>
<div data-step-form="2" class="hidden space-y-6">
            <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
              <h3 class="font-heading text-lg font-semibold text-ink">Shipping Address</h3>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div><label for="firstName" class="block text-sm font-medium text-ink mb-1">First Name <span class="text-red-500">*</span></label><input type="text" id="firstName" name="firstName" required autoComplete="given-name" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" /></div>
                <div><label for="lastName" class="block text-sm font-medium text-ink mb-1">Last Name <span class="text-red-500">*</span></label><input type="text" id="lastName" name="lastName" required autoComplete="family-name" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" /></div>
              </div>
<div class="mt-4"><label for="address1" class="block text-sm font-medium text-ink mb-1">Address <span class="text-red-500">*</span></label><input type="text" id="address1" name="address1" required autoComplete="street-address" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" placeholder="123 Main Street" /></div>
              <div class="mt-4"><label for="address2" class="block text-sm font-medium text-ink mb-1">Apartment, suite, etc. (optional)</label><input type="text" id="address2" name="address2" autoComplete="address-line2" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" /></div>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div><label for="city" class="block text-sm font-medium text-ink mb-1">City <span class="text-red-500">*</span></label><input type="text" id="city" name="city" required autoComplete="address-level2" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" /></div>
                <div><label for="state" class="block text-sm font-medium text-ink mb-1">State / Province <span class="text-red-500">*</span></label><input type="text" id="state" name="state" required autoComplete="address-level1" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" /></div>
              </div>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div><label for="zip" class="block text-sm font-medium text-ink mb-1">ZIP / Postal Code <span class="text-red-500">*</span></label><input type="text" id="zip" name="zip" required autoComplete="postal-code" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" /></div>
                <div><label for="country" class="block text-sm font-medium text-ink mb-1">Country <span class="text-red-500">*</span></label><select id="country" name="country" required autoComplete="country" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20"><option value="US">United States</option><option value="CA">Canada</option><option value="GB">United Kingdom</option><option value="AU">Australia</option></select></div>
              </div>
            </div>

            <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
              <h3 class="font-heading text-lg font-semibold text-ink">Shipping Method</h3>
              <div class="mt-4 space-y-3" role="radiogroup" aria-label="Shipping options">
                <label class="flex items-center gap-3 rounded-xl border border-line bg-paper p-4 cursor-pointer hover:border-ink/50 transition"><input type="radio" name="shippingMethod" value="standard" checked class="sr-only" /><span class="flex h-5 w-5 items-center justify-center rounded border-2 border-line bg-paper text-ink"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="5"/></svg></span><div class="flex-1"><p class="font-medium text-ink">Standard Shipping</p><p class="text-sm text-muted">5-7 business days</p></div><span class="font-medium text-ink" data-shipping-standard>FREE</span></label>
                <label class="flex items-center gap-3 rounded-xl border border-line bg-paper p-4 cursor-pointer hover:border-ink/50 transition"><input type="radio" name="shippingMethod" value="express" class="sr-only" /><span class="flex h-5 w-5 items-center justify-center rounded border-2 border-line bg-paper text-ink"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="5"/></svg></span><div class="flex-1"><p class="font-medium text-ink">Express Shipping</p><p class="text-sm text-muted">2-3 business days</p></div><span class="font-medium text-ink" data-shipping-express>$25.00</span></label>
                <label class="flex items-center gap-3 rounded-xl border border-line bg-paper p-4 cursor-pointer hover:border-ink/50 transition"><input type="radio" name="shippingMethod" value="overnight" class="sr-only" /><span class="flex h-5 w-5 items-center justify-center rounded border-2 border-line bg-paper text-ink"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="5"/></svg></span><div class="flex-1"><p class="font-medium text-ink">Overnight Shipping</p><p class="text-sm text-muted">Next business day</p></div><span class="font-medium text-ink" data-shipping-overnight>$50.00</span></label>
              </div>
            </div>
          </div>

<div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
              <h3 class="font-heading text-lg font-semibold text-ink">Payment Method</h3>
              <div class="mt-4 grid gap-4" role="radiogroup" aria-label="Payment options">
                <label class="flex items-center gap-3 rounded-xl border border-line bg-paper p-4 cursor-pointer hover:border-ink/50 transition"><input type="radio" name="paymentMethod" value="card" checked class="sr-only" /><span class="flex h-5 w-5 items-center justify-center rounded border-2 border-line bg-paper text-ink"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="5"/></svg></span><div class="flex items-center gap-2"><svg width="24" height="16" viewBox="0 0 24 16" fill="currentColor" class="text-muted"><path d="M20 4H4a2 2 0 00-2 2v8a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 10H4V6h16v8z"/></svg><svg width="24" height="16" viewBox="0 0 24 16" fill="currentColor" class="text-muted"><path d="M20 4H4a2 2 0 00-2 2v8a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 10H4V6h16v8z"/></svg></div><span class="ml-auto text-sm text-muted">Credit / Debit Card</span></label>
          <div data-step-form="3" class="hidden space-y-6">
<label class="flex items-center gap-3 rounded-xl border border-line bg-paper p-4 cursor-pointer hover:border-ink/50 transition"><input type="radio" name="paymentMethod" value="bkash" class="sr-only" /><span class="flex h-5 w-5 items-center justify-center rounded border-2 border-line bg-paper text-ink"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="5"/></svg></span><div class="flex items-center gap-2"><svg width="32" height="20" viewBox="0 0 32 20" fill="currentColor" class="text-pink-500"><text x="2" y="14" font-size="14" font-weight="bold">bKash</text></svg></div><span class="ml-auto text-sm text-muted">bKash (Mobile Banking)</span></label>
                <label class="flex items-center gap-3 rounded-xl border border-line bg-paper p-4 cursor-pointer hover:border-ink/50 transition"><input type="radio" name="paymentMethod" value="nagad" class="sr-only" /><span class="flex h-5 w-5 items-center justify-center rounded border-2 border-line bg-paper text-ink"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="5"/></svg></span><div class="flex items-center gap-2"><svg width="32" height="20" viewBox="0 0 32 20" fill="currentColor" class="text-orange-500"><text x="2" y="14" font-size="14" font-weight="bold">Nagad</text></svg></div><span class="ml-auto text-sm text-muted">Nagad (Digital Wallet)</span></label>
                <label class="flex items-center gap-3 rounded-xl border border-line bg-paper p-4 cursor-pointer hover:border-ink/50 transition"><input type="radio" name="paymentMethod" value="ssl" class="sr-only" /><span class="flex h-5 w-5 items-center justify-center rounded border-2 border-line bg-paper text-ink"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="5"/></svg></span><div class="flex items-center gap-2"><svg width="32" height="20" viewBox="0 0 32 20" fill="currentColor" class="text-blue-600"><text x="2" y="14" font-size="12" font-weight="bold">SSLCOMMERZ</text></svg></div><span class="ml-auto text-sm text-muted">SSLCOMMERZ (Bank/Card/Wallet)</span></label>
              </div>

              <div data-payment-card class="mt-6 space-y-4" style="display: block;">
                <div class="grid gap-4 sm:grid-cols-2">
                  <div><label for="cardNumber" class="block text-sm font-medium text-ink mb-1">Card Number <span class="text-red-500">*</span></label><input type="text" id="cardNumber" name="cardNumber" required autoComplete="cc-number" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" placeholder="4242 4242 4242 4242" maxlength="19" /></div>
                  <div><label for="cardName" class="block text-sm font-medium text-ink mb-1">Name on Card <span class="text-red-500">*</span></label><input type="text" id="cardName" name="cardName" required autoComplete="cc-name" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" placeholder="John Doe" /></div>
                </div>
                <div class="grid gap-4 sm:grid-cols-3">
                  <div><label for="cardExpiry" class="block text-sm font-medium text-ink mb-1">Expiry <span class="text-red-500">*</span></label><input type="text" id="cardExpiry" name="cardExpiry" required autoComplete="cc-exp" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" placeholder="MM/YY" maxlength="5" /></div>
                  <div><label for="cardCvc" class="block text-sm font-medium text-ink mb-1">CVC <span class="text-red-500">*</span></label><input type="text" id="cardCvc" name="cardCvc" required autoComplete="cc-csc" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" placeholder="123" maxlength="4" /></div>
                  <div><label for="cardPostal" class="block text-sm font-medium text-ink mb-1">Billing ZIP <span class="text-red-500">*</span></label><input type="text" id="cardPostal" name="cardPostal" required autoComplete="billing-postal-code" class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" placeholder="12345" /></div>
                </div>
<div data-payment-bkash class="hidden mt-6 space-y-4"><div><label for="bkashNumber" class="block text-sm font-medium text-ink mb-1">bKash Number <span class="text-red-500">*</span></label><input type="tel" id="bkashNumber" name="bkashNumber" required class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" placeholder="01XXXXXXXXX" pattern="01[0-9]{9}" /></div><p class="text-sm text-muted">You'll receive a payment request on your bKash app.</p></div>

              <div data-payment-nagad class="hidden mt-6 space-y-4"><div><label for="nagadNumber" class="block text-sm font-medium text-ink mb-1">Nagad Number <span class="text-red-500">*</span></label><input type="tel" id="nagadNumber" name="nagadNumber" required class="w-full rounded-md border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" placeholder="01XXXXXXXXX" pattern="01[0-9]{9}" /></div><p class="text-sm text-muted">You'll receive a payment request on your Nagad app.</p></div>

              <div data-payment-ssl class="hidden mt-6 space-y-4"><p class="text-sm text-muted">You'll be redirected to SSLCOMMERZ secure payment gateway to complete your purchase.</p></div>
            </div>
          </div>

          <div data-step-form="4" class="hidden space-y-6">
<div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
              <h3 class="font-heading text-lg font-semibold text-ink">Review Your Order</h3>
              <div class="mt-4 space-y-3" data-review-items></div>
              <div class="mt-4 pt-4 border-t border-line space-y-2">
                <div class="flex justify-between text-sm"><span class="text-muted">Subtotal</span><span class="font-medium text-ink" data-review-subtotal>$0.00</span></div>
                <div class="flex justify-between text-sm"><span class="text-muted">Shipping</span><span class="font-medium text-ink" data-review-shipping>FREE</span></div>
                <div class="flex justify-between text-sm"><span class="text-muted">Tax (8%)</span><span class="font-medium text-ink" data-review-tax>$0.00</span></div>
                <div class="flex justify-between text-sm"><span class="text-muted">Discount</span><span class="font-medium text-pine" data-review-discount>-$0.00</span></div>
                <div class="flex justify-between pt-2 border-t border-line"><span class="font-semibold text-ink">Total</span><span class="font-semibold text-ink" data-review-total>$0.00</span></div>
              </div>
            </div>

            <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
              <h3 class="font-heading text-lg font-semibold text-ink">Contact & Shipping</h3>
              <div class="mt-4 space-y-1 text-sm text-muted" data-review-contact></div>
            </div>

            <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
              <h3 class="font-heading text-lg font-semibold text-ink">Payment Method</h3>
              <p class="mt-2 text-sm text-muted" data-review-payment></p>
            </div>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-line">
            <button type="button" data-prev-step class="hidden rounded-md border border-line bg-paper px-5 py-2.5 text-sm font-medium text-ink hover:border-ink hover:text-ink transition">Back</button>
            <div class="flex items-center gap-3">
              <button type="button" data-next-step class="rounded-md bg-ink px-6 py-2.5 text-sm font-semibold text-paper hover:bg-ink/90 transition">Continue<svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M13.5 4.5L21 12l-7.5 7.5"/></svg></button>
              <button type="submit" data-place-order class="hidden rounded-md bg-pine px-6 py-2.5 text-sm font-semibold text-pine-soft hover:bg-pine/90 transition">Place Order</button>
            </div>
          </div>
        </form>
      </section>
<aside class="mt-8 lg:mt-0 lg:col-span-5 lg:self-start lg:sticky lg:top-24" aria-labelledby="summary-heading">
        <div class="rounded-2xl border border-line bg-paper/90 p-5 sm:p-6">
          <h2 id="summary-heading" class="font-heading text-lg font-semibold text-ink">Order Summary</h2>
          <div class="mt-4 max-h-64 overflow-y-auto" data-summary-items></div>
          <div class="mt-4 space-y-3 border-t border-line pt-4">
            <div class="flex justify-between text-sm"><span class="text-muted">Subtotal</span><span class="font-medium text-ink" data-summary-subtotal>$0.00</span></div>
            <div class="flex justify-between text-sm"><span class="text-muted">Shipping</span><span class="font-medium text-ink" data-summary-shipping>FREE</span></div>
            <div class="flex justify-between text-sm"><span class="text-muted">Estimated Tax (8%)</span><span class="font-medium text-ink" data-summary-tax>$0.00</span></div>
            <div class="flex justify-between text-sm text-pine"><span>Discount</span><span data-summary-discount>-$0.00</span></div>
            <div class="flex justify-between pt-2 border-t border-line"><span class="font-semibold text-ink">Total</span><span class="font-semibold text-ink text-lg" data-summary-total>$0.00</span></div>
          </div>
          <p class="mt-4 text-xs text-muted text-center">{isMock ? 'Demo mode: No real payment will be processed.' : 'Secure checkout powered by SSLCOMMERZ'}</p>
        </div>
        <div class="mt-6 grid grid-cols-3 gap-4 text-center">
          <div class="rounded-xl border border-line bg-paper/50 p-4"><svg class="mx-auto h-8 w-8 text-pine" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg><p class="mt-2 text-xs font-medium text-ink">Secure Payment</p><p class="text-[10px] text-muted">SSL Encrypted</p></div>
          <div class="rounded-xl border border-line bg-paper/50 p-4"><svg class="mx-auto h-8 w-8 text-pine" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg><p class="mt-2 text-xs font-medium text-ink">30-Day Returns</p><p class="text-[10px] text-muted">Easy Returns</p></div>
          <div class="rounded-xl border border-line bg-paper/50 p-4"><svg class="mx-auto h-8 w-8 text-pine" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg><p class="mt-2 text-xs font-medium text-ink">Manufacturer Warranty</p><p class="text-[10px] text-muted">1-5 Years</p></div>
        </div>
      </aside>
    </div>

    <div id="success-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/50" role="dialog" aria-modal="true" aria-labelledby="success-title">
      <div class="w-full max-w-md rounded-2xl bg-paper p-6 sm:p-8 text-center animate-fade-up">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-pine/10"><svg class="h-8 w-8 text-pine" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
        <h3 id="success-title" class="mt-4 font-display text-2xl font-extrabold text-ink">Order Confirmed!</h3>
        <p class="mt-2 text-muted">Thank you for your purchase. Your order number is <span class="font-semibold text-ink" data-order-number>#KH-000000</span>.</p>
        <p class="mt-1 text-sm text-muted">A confirmation email has been sent to <span data-order-email></span>.</p>
        <div class="mt-6 rounded-xl border border-line bg-paper/50 p-4 text-left"><p class="font-medium text-ink">What happens next?</p><ul class="mt-3 space-y-2 text-sm text-muted"><li class="flex items-center gap-2"><svg class="h-4 w-4 text-pine flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3 3a.75.75 0 001.06 1.06l1.72-1.72 1.72 1.72a.75.75 0 101.06-1.06l-3-3z"/></svg> We'll prepare your order for shipment</li><li class="flex items-center gap-2"><svg class="h-4 w-4 text-pine flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 001.06 1.06l1.72-1.72 1.72 1.72a.75.75 0 101.06-1.06l-3-3z"/></svg> You'll receive tracking info via email</li><li class="flex items-center gap-2"><svg class="h-4 w-4 text-pine flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 001.06 1.06l1.72-1.72 1.72 1.72a.75.75 0 101.06-1.06l-3-3z"/></svg> Delivery within 5-7 business days</li></ul></div>
        <a href="/" class="mt-6 inline-flex items-center justify-center rounded-md bg-ink px-6 py-3 text-sm font-semibold text-paper hover:bg-ink/90 transition">Continue Shopping</a>
      </div>
    </div>
<script is:inline>
    (() => {
      const STORAGE_KEY = "njx-store-cart";
      const SHIPPING_THRESHOLD = 50000;
      const SHIPPING_COST = 1500;
      const TAX_RATE = 0.08;

      function getCart() {
        try { const data = localStorage.getItem(STORAGE_KEY); return data ? JSON.parse(data) : []; } catch { return []; }
      }

      function formatMoney(amount, currency = "USD") {
        return new Intl.NumberFormat("en-US", { style: "currency", currency }).format(amount / 100);
      }

      let currentStep = 1;
      let promoDiscount = 0;
      let selectedShipping = "standard";
      let selectedPayment = "card";

      const forms = { 1: document.querySelector("[data-step-form=\"1\"]"), 2: document.querySelector("[data-step-form=\"2\"]"), 3: document.querySelector("[data-step-form=\"3\"]"), 4: document.querySelector("[data-step-form=\"4\"]") };
      const stepIndicators = document.querySelectorAll("[data-step]");
      const prevBtn = document.querySelector("[data-prev-step]");
      const nextBtn = document.querySelector("[data-next-step]");
      const placeOrderBtn = document.querySelector("[data-place-order]");
      const summaryItems = document.querySelector("[data-summary-items]");
      const reviewItems = document.querySelector("[data-review-items]");
      const reviewContact = document.querySelector("[data-review-contact]");
      const reviewPayment = document.querySelector("[data-review-payment]");
      const successModal = document.getElementById("success-modal");

      function init() {
        renderSummary();
        renderReview();
        updateStepUI();
        attachListeners();
      }

      function attachListeners() {
        nextBtn?.addEventListener("click", () => { if (validateStep(currentStep)) goToStep(currentStep + 1); });
        prevBtn?.addEventListener("click", () => goToStep(currentStep - 1));
        placeOrderBtn?.addEventListener("click", handlePlaceOrder);

        document.querySelectorAll("input[name=\"shippingMethod\"]").forEach(radio => { radio.addEventListener("change", (e) => { selectedShipping = e.target.value; renderSummary(); renderReview(); }); });
        document.querySelectorAll("input[name=\"paymentMethod\"]").forEach(radio => { radio.addEventListener("change", (e) => { selectedPayment = e.target.value; togglePaymentForms(); renderReview(); }); });

        const cardNumber = document.getElementById("cardNumber");
        const cardExpiry = document.getElementById("cardExpiry");
        cardNumber?.addEventListener("input", (e) => { let v = e.target.value.replace(/\s/g, "").replace(/\D/g, ""); v = v.replace(/(.{4})/g, "$1 ").trim(); e.target.value = v.substring(0, 19); });
        cardExpiry?.addEventListener("input", (e) => { let v = e.target.value.replace(/\D/g, ""); if (v.length >= 2) v = v.substring(0, 2) + "/" + v.substring(2, 4); e.target.value = v.substring(0, 5); });
      }

      function validateStep(step) {
        const form = forms[step];
        if (!form) return true;
        const inputs = form.querySelectorAll("input[required], select[required]");
        let valid = true;
        inputs.forEach(input => { if (!input.checkValidity()) { input.reportValidity(); valid = false; } });
        return valid;
      }

      function goToStep(step) {
        if (step < 1 || step > 4) return;
        currentStep = step;
        updateStepUI();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      function updateStepUI() {
        Object.entries(forms).forEach(([num, form]) => { if (form) form.classList.toggle("hidden", parseInt(num) !== currentStep); });
        stepIndicators.forEach(indicator => { const stepNum = parseInt(indicator.dataset.step); const svg = indicator.querySelector("svg"); if (stepNum <= currentStep) { indicator.classList.remove("bg-paper", "border-line", "text-muted"); indicator.classList.add("bg-ink", "border-ink", "text-paper"); if (svg) svg.innerHTML = "<path d=\"M20 6 9 17l-5-5\"/>" } else { indicator.classList.remove("bg-ink", "border-ink", "text-paper"); indicator.classList.add("bg-paper", "border-line", "text-muted"); } });
        prevBtn?.classList.toggle("hidden", currentStep === 1);
        nextBtn?.classList.toggle("hidden", currentStep === 4);
        placeOrderBtn?.classList.toggle("hidden", currentStep !== 4);
      }
function togglePaymentForms() {
        document.querySelectorAll("[data-payment-card], [data-payment-bkash], [data-payment-nagad], [data-payment-ssl]").forEach(el => el.classList.add("hidden"));
        const el = document.querySelector(`[data-payment-${selectedPayment}]`); el?.classList.remove("hidden");
      }

      function getShippingCost() { switch (selectedShipping) { case "express": return 2500; case "overnight": return 5000; default: return 0; } }

      function calculateTotals() { const lines = getCart(); const subtotal = lines.reduce((s, l) => s + l.price.amount * l.quantity, 0); const shipping = getShippingCost(); const afterDiscount = Math.max(0, subtotal - promoDiscount); const tax = Math.round(afterDiscount * TAX_RATE); const total = afterDiscount + shipping + tax; return { subtotal, shipping, tax, total, discount: promoDiscount }; }

      function renderSummary() { const lines = getCart(); const { subtotal, shipping, tax, total, discount } = calculateTotals(); if (summaryItems) { summaryItems.innerHTML = lines.map(line => `<div class="flex gap-3 py-3 border-b border-line last:border-0"><img src="${line.image?.src || ""}" alt="${line.title}" class="h-16 w-16 rounded-lg object-cover bg-line" loading="lazy" /><div class="flex-1 min-w-0"><p class="font-medium text-ink truncate">${line.title}</p>${line.variantTitle && line.variantTitle !== "Default" ? `<p class="text-sm text-muted">${line.variantTitle}</p>` : ""}<p class="text-sm text-ink">Qty: ${line.quantity}</p></div><span class="font-medium text-ink whitespace-nowrap">${formatMoney(line.price.amount * line.quantity)}</span></div>`).join("") || "<p class=\"text-muted text-center py-4\">Cart is empty</p>"; } document.querySelector("[data-summary-subtotal]")?.textContent = formatMoney(subtotal); document.querySelector("[data-summary-shipping]")?.textContent = shipping === 0 ? "FREE" : formatMoney(shipping); document.querySelector("[data-summary-tax]")?.textContent = formatMoney(tax); document.querySelector("[data-summary-discount]")?.textContent = discount > 0 ? "-" + formatMoney(discount) : "-$0.00"; document.querySelector("[data-summary-total]")?.textContent = formatMoney(total); document.querySelector("[data-shipping-standard]")?.textContent = formatMoney(0); document.querySelector("[data-shipping-express]")?.textContent = formatMoney(2500); document.querySelector("[data-shipping-overnight]")?.textContent = formatMoney(5000); }

      function renderReview() { const lines = getCart(); const { subtotal, shipping, tax, total, discount } = calculateTotals(); if (reviewItems) { reviewItems.innerHTML = lines.map(line => `<div class="flex gap-3 py-2"><img src="${line.image?.src || ""}" alt="" class="h-12 w-12 rounded-lg object-cover bg-line" loading="lazy" /><div class="flex-1 min-w-0"><p class="font-medium text-ink truncate">${line.title}</p><p class="text-sm text-muted">Qty: ${line.quantity}</p></div><span class="font-medium text-ink">${formatMoney(line.price.amount * line.quantity)}</span></div>`).join(""); } document.querySelector("[data-review-subtotal]")?.textContent = formatMoney(subtotal); document.querySelector("[data-review-shipping]")?.textContent = shipping === 0 ? "FREE" : formatMoney(shipping); document.querySelector("[data-review-tax]")?.textContent = formatMoney(tax); document.querySelector("[data-review-discount]")?.textContent = "-" + formatMoney(discount); document.querySelector("[data-review-total]")?.textContent = formatMoney(total); const email = document.getElementById("email")?.value; const firstName = document.getElementById("firstName")?.value; const lastName = document.getElementById("lastName")?.value; const address1 = document.getElementById("address1")?.value; const city = document.getElementById("city")?.value; const state = document.getElementById("state")?.value; const zip = document.getElementById("zip")?.value; const country = document.getElementById("country")?.value; if (reviewContact) { reviewContact.innerHTML = `<p>${email || "—"}</p>${firstName || lastName ? `<p>${firstName} ${lastName}</p>` : ""}${address1 ? `<p>${address1}</p>` : ""}${document.getElementById("address2")?.value ? `<p>${document.getElementById("address2").value}</p>` : ""}${city || state || zip ? `<p>${city}, ${state} ${zip}</p>` : ""}${country ? `<p>${country}</p>` : ""}`.trim() || "<p>—</p>"; } const paymentLabels = { card: "Credit / Debit Card ending in " + (document.getElementById("cardNumber")?.value?.slice(-4) || "****"), bkash: "bKash Mobile Banking", nagad: "Nagad Digital Wallet", ssl: "SSLCOMMERZ Payment Gateway" }; if (reviewPayment) reviewPayment.textContent = paymentLabels[selectedPayment] || "—"; }

      async function handlePlaceOrder(e) { e.preventDefault(); if (!validateStep(4)) return; const lines = getCart(); if (!lines.length) return; placeOrderBtn.disabled = true; placeOrderBtn.textContent = "Processing..."; await new Promise(r => setTimeout(r, 1500)); const orderNumber = "#KH-" + Math.random().toString(36).substring(2, 8).toUpperCase(); const email = document.getElementById("email")?.value; localStorage.removeItem(STORAGE_KEY); document.querySelector("[data-order-number]")?.textContent = orderNumber; document.querySelector("[data-order-email]")?.textContent = email; successModal?.classList.remove("hidden"); successModal?.classList.add("flex"); window.dispatchEvent(new CustomEvent("cart-update")); }

      window.addEventListener("storage", (e) => { if (e.key === STORAGE_KEY) { renderSummary(); renderReview(); } });
      window.addEventListener("cart-update", () => { renderSummary(); renderReview(); });

      init();
    })();
  </script>
</main>
</Layout>
