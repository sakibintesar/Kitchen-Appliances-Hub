---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { commerce } from '../lib/commerce';
import { HOME as T } from '../constants/pages';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import FluidCursor from '../components/islands/FluidCursor.tsx';
import InfiniteGrid from '../components/islands/InfiniteGrid.tsx';
import MagneticCursor from '../components/islands/MagneticCursor.tsx';
import KineticHero from '../components/islands/KineticHero.tsx';
import Product3DViewer from '../components/islands/Product3DViewer.tsx';
import ScrollTriggered3D from '../components/islands/ScrollTriggered3D.tsx';

const [products, collections] = await Promise.all([
  commerce.listProducts({ limit: 12 }),
  commerce.listCollections(),
]);

// Hero slides with 3D integration
const heroSlides = [
  {
    id: 'wolf',
    image: 'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?w=1920&h=1080&fit=crop',
    alt: 'Wolf professional range in luxury kitchen',
    badge: 'Professional Cooking',
    eyebrow: 'Wolf Range Series',
    title: 'Where culinary ambition meets engineering excellence',
    subtitle: 'Restaurant-grade precision for the home chef. Dual-stacked burners, infrared charbroiler, and convection oven.',
    cta: { label: 'Explore Wolf Ranges', href: '/collections/cooking' },
    accentColor: 'from-amber-500/20 to-orange-500/10',
    productHandle: 'wolf-36-dual-fuel-range',
    model3d: 'wolf',
  },
  {
    id: 'subzero',
    image: 'https://images.unsplash.com/photo-1571175443880-49e1d25b2bc5?w=1920&h=1080&fit=crop',
    alt: 'Sub-Zero refrigerator in modern kitchen',
    badge: 'Premium Refrigeration',
    eyebrow: 'Sub-Zero Collection',
    title: 'Preservation perfected. Freshness redefined.',
    subtitle: 'Dual refrigeration system. NASA-inspired air purification. 20-year design life.',
    cta: { label: 'Discover Sub-Zero', href: '/collections/refrigeration' },
    accentColor: 'from-sky-500/20 to-blue-500/10',
    productHandle: 'sub-zero-48-pro-french-door',
    model3d: 'subzero',
  },
  {
    id: 'miele',
    image: 'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=1920&h=1080&fit=crop',
    alt: 'Miele dishwasher with 3D+ cutlery tray',
    badge: 'German Engineering',
    eyebrow: 'Miele Dishwashers',
    title: 'The quietest clean you\'ll ever experience.',
    subtitle: '3D+ cutlery tray. AutoOpen drying. 38 dB silence. 20-year tested longevity.',
    cta: { label: 'View Miele', href: '/collections/dishwashers' },
    accentColor: 'from-emerald-500/20 to-teal-500/10',
    productHandle: 'miele-g7000-dishwasher',
    model3d: 'miele',
  },
  {
    id: 'lamarzocco',
    image: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1920&h=1080&fit=crop',
    alt: 'La Marzocco Linea Micra espresso machine',
    badge: 'Barista Quality',
    eyebrow: 'La Marzocco Home',
    title: 'Café-grade espresso. Kitchen counter footprint.',
    subtitle: 'Dual boiler. PID temperature control. Saturated groups. Commercial steam power.',
    cta: { label: 'Shop Espresso', href: '/collections/small-appliances' },
    accentColor: 'from-amber-600/20 to-amber-800/10',
    productHandle: 'la-marzocco-linea-micra',
    model3d: 'lamarzocco',
  },
];

const experienceSlides = (await getCollection('experiences'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);

const collectionImages: Record<string, string> = {
  cooking: 'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?w=800&h=600&fit=crop',
  refrigeration: 'https://images.unsplash.com/photo-1571175443880-49e1d25b2bc5?w=800&h=600&fit=crop',
  dishwashers: 'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?w=800&h=600&fit=crop',
  ventilation: 'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=800&h=600&fit=crop',
  'small-appliances': 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=800&h=600&fit=crop',
};
---

<Layout>
  <!-- Magnetic Cursor (Global) -->
  <MagneticCursor client:load />
  
  <!-- Fluid Cursor (Global) -->
  <FluidCursor client:load />

  <!-- ==========================================
       KINETIC HERO: SVG Text Warping + Torn Page Anchor + Scroll-Triggered 3D
       ========================================== -->
  <KineticHero client:load slides={heroSlides} />

  <!-- Brand Promise Bar - Sticky on Scroll -->
  <section class="sticky top-0 z-40 border-y border-neutral-200/50 dark:border-neutral-700/50 bg-neutral-50/80 dark:bg-neutral-900/80 backdrop-blur-md">
    <div class="mx-auto max-w-7xl px-5 py-4">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-[13px] text-muted font-medium">
        <div class="flex items-center gap-2 group">
          <svg class="w-5 h-5 text-gold-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>White-glove delivery & installation</span>
        </div>
        <div class="flex items-center gap-2 group">
          <svg class="w-5 h-5 text-gold-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>2-year warranty on all appliances</span>
        </div>
        <div class="flex items-center gap-2 group">
          <svg class="w-5 h-5 text-gold-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H7v-2c0-.656.126-1.283.356-1.857M7 20H7v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <span>Expert design consultation</span>
        </div>
        <div class="flex items-center gap-2 group">
          <svg class="w-5 h-5 text-gold-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Price match guarantee</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
         INFINITE GRID SCROLL EXPERIENCE
         ========================================== -->
    <section class="relative min-h-[200vh] bg-neutral-950" data-infinite-experience>
      <!-- Scroll-Triggered 3D Background -->
      <ScrollTriggered3D 
        client:load 
        slides={[
          { id: 'products', model3d: 'wolf', title: 'Wolf 36" Dual Fuel Range', category: 'Professional Cooking', href: '/products/wolf-36-dual-fuel-range' },
          { id: 'trust', model3d: 'subzero', title: 'Sub-Zero 48" Pro French Door', category: 'Premium Refrigeration', href: '/products/sub-zero-48-pro-french-door' },
          { id: 'experiences', model3d: 'miele', title: 'Miele G7000 Dishwasher', category: 'German Engineering', href: '/products/miele-g7000-dishwasher' },
          { id: 'cta', model3d: 'lamarzocco', title: 'La Marzocco Linea Micra', category: 'Barista Quality', href: '/products/la-marzocco-linea-micra' },
        ]}
        className="absolute inset-0 -z-10 opacity-30"
      />
    
      <!-- Scroll-Triggered Content Sections -->
            <div class="relative z-10 w-full">

              <!-- Section 1: Featured 3D Products with Scroll Parallax -->
              <section class="relative min-h-screen flex items-center justify-center px-5" data-scroll-section="products">
                <div class="relative z-10 w-full max-w-7xl mx-auto px-5">
                  <header class="text-center max-w-3xl mx-auto mb-16" data-scroll-fade>
                    <span class="inline-flex items-center gap-2 rounded-full bg-gold-500/10 px-4 py-1.5 text-[12px] font-medium text-gold-400 uppercase tracking-wider border border-gold-500/20">
                      Featured Innovations
                    </span>
                    <h2 class="mt-5 font-display text-[clamp(36px,6vw,56px)] font-extrabold leading-[0.9] tracking-tight text-white">
                      Engineering excellence you can experience
                    </h2>
                    <p class="mt-5 text-[clamp(18px,3vw,24px)] leading-relaxed text-white/70 max-w-[60ch] mx-auto">
                      Each appliance represents decades of engineering mastery. Hover to explore in 3D, configure your dream kitchen, and experience the difference.
                    </p>
                  </header>

                  <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
                    {[
                      { handle: 'wolf-36-dual-fuel-range', label: 'Wolf 36" Dual Fuel Range', category: 'Professional Cooking', model3d: 'wolf', href: '/products/wolf-36-dual-fuel-range' },
                      { handle: 'sub-zero-48-pro-french-door', label: 'Sub-Zero 48" Pro French Door', category: 'Premium Refrigeration', model3d: 'subzero', href: '/products/sub-zero-48-pro-french-door' },
                      { handle: 'miele-g7000-dishwasher', label: 'Miele G7000 Dishwasher', category: 'German Engineering', model3d: 'miele', href: '/products/miele-g7000-dishwasher' },
                      { handle: 'la-marzocco-linea-micra', label: 'La Marzocco Linea Micra', category: 'Barista Quality', model3d: 'lamarzocco', href: '/products/la-marzocco-linea-micra' },
                    ].map((product, i) => (
                      <article 
                        class="group relative overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900/50 transition-all duration-700 hover:border-gold-500/50 hover:shadow-[0_0_80px_rgba(212,175,55,0.15)] hover:scale-[1.01] animate-fade-up"
                        style={{animationDelay: `${100 + i * 100}ms`}}
                        data-scroll-parallax
                      >
                        <div class="relative aspect-[4/3] overflow-hidden bg-neutral-900">
                          <Product3DViewer 
                            client:visible
                            productHandle={product.handle}
                            className="w-full h-full"
                            data-magnetic
                            data-magnetic-strength="1.5"
                            data-magnetic-scale="1.2"
                          />
            
                          <!-- 3D Badge -->
                          <div class="absolute top-4 left-4">
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1.5 text-[11px] font-medium text-neutral-900 backdrop-blur border border-white/50 shadow-lg">
                              <svg class="w-3.5 h-3.5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                              </svg>
                              3D Interactive
                            </span>
                          </div>
            
                          <!-- Hover indicator -->
                          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-4 group-hover:translate-y-0">
                            <span class="inline-flex items-center gap-2 rounded-2xl bg-white px-6 py-3 text-[14px] font-semibold text-neutral-900 shadow-2xl hover:bg-gold-50 hover:shadow-[0_0_60px_rgba(212,175,55,0.4)] transition-all duration-300">
                              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                              </svg>
                              Hover to Explore
                            </span>
                          </div>
                        </div>
    
                        <!-- Product Info -->
                        <div class="p-6 sm:p-8">
                          <span class="inline-flex items-center gap-1.5 rounded-full bg-gold-500/10 px-3 py-1 text-[11px] font-medium text-gold-400 uppercase tracking-wider border border-gold-500/20">
                            {product.category}
                          </span>
                          <h3 class="mt-4 font-display text-xl font-bold tracking-tight text-white group-hover:text-gold-400 transition-colors duration-300">
                            {product.label}
                          </h3>
                          <div class="mt-4 flex items-center gap-4">
                            <a href={product.href} class="inline-flex items-center gap-1.5 text-[14px] font-medium text-white/60 hover:text-gold-400 transition-colors duration-300">
                              Configure
                              <svg class="w-4 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                              </svg>
                            </a>
                            <a class="inline-flex items-center gap-1.5 text-[14px] font-medium text-white/60 hover:text-white/400 transition-colors duration-300">
                              Compare
                              <svg class="w-4 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                              </svg>
                            </a>
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>
                  
                  <div class="mt-16 text-center" data-scroll-fade>
                    <a href="/collections" class="inline-flex items-center gap-2 rounded-2xl border-2 border-gold-500 text-gold-400 font-semibold px-10 py-5 hover:bg-gold-500 hover:text-neutral-900 transition-all duration-500 shadow-xl shadow-gold-500/20">
                      View All Collections
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                      </svg>
                    </a>
                  </div>
                </div>
              </section>

      <!-- Section 2: Why KitchenHub - Trust Pillars -->
      <section class="relative min-h-screen flex items-center justify-center px-5 bg-neutral-900/50" data-scroll-section="trust">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(212,175,55,0.08)_0%,_transparent_70%)]" aria-hidden="true" />
        
        <div class="relative z-10 w-full max-w-7xl mx-auto px-5">
          <header class="text-center max-w-3xl mx-auto mb-16" data-scroll-fade>
            <span class="inline-flex items-center gap-2 rounded-full bg-gold-500/10 px-4 py-1.5 text-[12px] font-medium text-gold-400 uppercase tracking-wider border border-gold-500/20">
              Why KitchenHub
            </span>
            <h2 class="mt-5 font-display text-[clamp(36px,6vw,56px)] font-extrabold leading-[0.9] tracking-tight text-white">
              Trusted by designers, chefs & homeowners
            </h2>
            <p class="mt-5 text-[clamp(18px,3vw,24px)] leading-relaxed text-white/70 max-w-[55ch] mx-auto">
              We don't just sell appliances. We curate the world's finest kitchen engineering and deliver it with expertise that transforms houses into culinary homes.
            </p>
          </header>

          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
            {[
              { icon: 'truck', title: 'White-Glove Delivery', desc: 'Professional installation by certified technicians. We remove packaging, level, calibrate, and demo.' },
              { icon: 'shield', title: '2-Year Warranty', desc: 'Full coverage on parts & labor. Extended protection plans available up to 5 years.' },
              { icon: 'headphones', title: 'Expert Support', desc: 'Direct access to product specialists. Design consultation. Post-installation care.' },
              { icon: 'sparkles', title: 'Curated Selection', desc: 'Every appliance vetted by our design team. Only the top 1% of global engineering makes our catalog.' },
            ].map((item, i) => (
              <article class="group relative p-6 sm:p-8 rounded-2xl border border-neutral-800 bg-neutral-900/50 transition-all duration-700 hover:border-gold-500/50 hover:shadow-[0_0_60px_rgba(212,175,55,0.15)] hover:scale-[1.01] animate-fade-up" style={{animationDelay: `${100 + i * 100}ms`}} data-scroll-parallax>
                <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-gold-500 via-gold-400 to-gold-500 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                <div class="relative mb-6">
                  <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gold-500/10 text-gold-500 group-hover:bg-gold-500 group-hover:text-white transition-all duration-500">
                    {item.icon === 'truck' && (
                      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010.986 10H6a2 2 0 00-2 2v5.66l-1 1.732A1 1 0 004 18.781V19a1 1 0 001 1h16a1 1 0 001-1v-.219a1 1 0 00-.553-.894l-1-1.732V13a1 1 0 00-1-1h-4.465l.496-.331A1 1 0 0014 12.115V9a1 1 0 00-1-1H7.586l-.537-.358A1 1 0 006 9.114V10a1 1 0 01-1.998.115l-.818-.818A2 2 0 013 7.182V5a2 2 0 012-2h14a2 2 0 012 2v2.182l-.818.818A1 1 0 0115 10.885v.5z" />
                      </svg>
                    )}
                    {item.icon === 'shield' && (
                      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0112 2.944a11.959 11.959 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                      </svg>
                    )}
                    {item.icon === 'headphones' && (
                      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5" />
                      </svg>
                    )}
                    {item.icon === 'sparkles' && (
                      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 15L9 30m0 0l3-3m-3 3h6M3.75 13.5l10.5-10.5a2.25 2.25 0 013.182 0 2.25 2.25 0 010 3.182l-10.5 10.5a2.25 2.25 0 01-3.182 0 2.25 2.25 0 010-3.182z" />
                      </svg>
                    )}
                  </div>
                </div>
                <h3 class="font-display text-xl font-bold text-white">White-Glove Delivery</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-white/60">Professional installation by certified technicians. We remove packaging, level, calibrate, and demo.</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Section 3: Experiences Grid -->
      <section class="relative min-h-screen flex items-center justify-center px-5 bg-neutral-950" data-scroll-section="experiences">
        <div class="relative z-10 w-full max-w-7xl mx-auto px-5">
          <header class="text-center max-w-3xl mx-auto mb-12" data-scroll-fade>
            <span class="inline-flex items-center gap-2 rounded-full bg-gold-500/10 px-4 py-1.5 text-[12px] font-medium text-gold-400 uppercase tracking-wider border border-gold-500/20">
              Curated Experiences
            </span>
            <h2 class="mt-5 font-display text-[clamp(36px,6vw,56px)] font-extrabold leading-[0.9] tracking-tight text-white">
              Kitchens Designed for How You Live
            </h2>
            <p class="mt-5 text-[clamp(18px,3vw,24px)] leading-relaxed text-white/70 max-w-[55ch] mx-auto">
              Real kitchens. Real stories. Real inspiration.
            </p>
          </header>

          <div class="grid gap-6 lg:grid-cols-2 xl:grid-cols-4">
            {experienceSlides.map((slide, i) => (
              <article class="group relative overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900/50 transition-all duration-700 hover:border-gold-500/50 hover:shadow-[0_0_60px_rgba(212,175,55,0.15)] hover:scale-[1.01] animate-fade-up" style={{animationDelay: `${100 + i * 100}ms`}} data-scroll-parallax>
                <a href={slide.cta.href} class="block" aria-label={`View ${slide.label} experience`}>
                  <div class="aspect-[4/3] overflow-hidden">
                    <Image
                      src={slide.heroImage}
                      alt={slide.heroAlt}
                      class="h-full w-full object-cover transition-all duration-1000 group-hover:scale-110"
                      loading="lazy"
                      width={600}
                      height={450}
                      decoding="async"
                    >
                      <source media="(max-width: 767px)" srcset={slide.heroImageMobile} />
                    </Image>
                  </div>
                </a>
                <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-neutral-900/95 via-neutral-900/30 to-transparent" aria-hidden="true" />
                <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-[11px] font-medium text-white backdrop-blur border border-white/20">
                    {slide.label}
                  </span>
                  <h3 class="mt-3 font-display text-[clamp(22px,3.5vw,32px)] font-extrabold leading-[1.0] tracking-tight text-white group-hover:underline group-hover:underline-offset-4 transition-colors duration-300">
                    <a href={slide.cta.href}>{slide.tagline}</a>
                  </h3>
                  <p class="mt-2 text-[14px] leading-relaxed text-white/70 line-clamp-2 max-w-[42ch]">
                    {slide.description}
                  </p>
                  <div class="mt-4 flex flex-wrap gap-3" role="list" aria-label="Key highlights">
                    {slide.stats.map((stat, sIdx) => (
                      <div class="flex items-center gap-1.5 rounded-full bg-white/5 px-3 py-1.5 text-white/80 transition hover:bg-white/10" role="listitem" style={{animationDelay: `${300 + sIdx * 60}ms`}}>
                        <span class="font-display font-extrabold text-white">{stat.value}</span>
                        <span class="text-[11px] font-medium uppercase tracking-wider">{stat.label}</span>
                      </div>
                    ))}
                  </div>
                  <div class="mt-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-4 border-t border-white/10">
                    <div class="flex flex-col">
