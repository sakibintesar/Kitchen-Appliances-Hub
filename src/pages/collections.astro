---
import Layout from '../layouts/Layout.astro';
import { commerce } from '../lib/commerce';
import { COLLECTION as T } from '../constants/pages';

const collections = await commerce.listCollections();
---

<Layout title="Collections — KitchenHub" description="Browse our premium kitchen appliance collections.">
  <main class="mx-auto max-w-6xl px-5 py-8 sm:py-12">
    <header class="mb-12">
      <h1 class="font-display text-[clamp(32px,5vw,52px)] font-extrabold tracking-tight">Collections</h1>
      <p class="mt-3 max-w-[52ch] text-[16px] leading-relaxed text-muted">
        Curated selections of professional-grade appliances for every culinary passion.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {collections.filter(c => c.handle !== 'frontpage').map((c) => (
        <a
          href={`/collections/${c.handle}`}
          class="group relative block rounded-2xl overflow-hidden border border-line bg-paper/50 transition hover:border-pine/50 hover:shadow-lg"
        >
          {c.image && (
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={c.image.src}
                alt={c.image.alt || c.title}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </div>
          )}
          <div class="p-6">
            <h2 class="font-heading text-xl font-semibold text-ink group-hover:text-pine transition">{c.title}</h2>
            <p class="mt-2 text-sm text-muted line-clamp-2">{c.description}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-pine group-hover:gap-2 transition">
              View collection
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>