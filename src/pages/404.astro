---
import Layout from '../layouts/Layout.astro';
import { NOT_FOUND as T } from '../constants/pages';
---

<Layout title={T.meta.title}>
  <section class="mx-auto max-w-2xl px-5 py-24 text-center">
    <h1 class="font-display text-[clamp(40px,7vw,72px)] font-extrabold tracking-tight">{T.title}</h1>
    <p class="mt-4 text-[16px] text-muted">{T.text}</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href={T.ctaPrimary.href} class="rounded-md bg-pine px-6 py-3.5 text-[15px] font-semibold text-white hover:bg-pine-deep">{T.ctaPrimary.label}</a>
      <a href={T.ctaSecondary.href} class="rounded-md border border-ink px-6 py-3.5 text-[15px] font-semibold hover:bg-tile">{T.ctaSecondary.label}</a>
    </div>
  </section>
</Layout>
