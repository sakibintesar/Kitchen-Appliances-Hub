  <script>
    (() => {
      const form = document.querySelector('[data-newsletter-form]');
      const successEl = document.getElementById('newsletter-success');
      if (!form || !successEl) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = form.querySelector('input[name="email"]').value;
        if (!email) return;

        try {
          await new Promise(r => setTimeout(r, 800));
          form.style.display = 'none';
          successEl.classList.remove('hidden');
          successEl.classList.add('animate-fade-up');
        } catch {}
      });
    })();
  </script>

  <!-- Hero 3D Script -->
  <script>
    (function() {
      const container = document.querySelector<HTMLElement>('[data-hero-3d]');
      if (!container) return;

      const slides = container.querySelectorAll<HTMLElement>('[data-hero-slide]');
      const dots = container.querySelectorAll<HTMLButtonElement>('[data-dot]');
      const content = container.querySelector<HTMLElement>('[data-hero-content]');
      const totalSlides = slides.length;
      let currentSlide = 0;
      let isTransitioning = false;
      let autoSlideInterval = null;
      const AUTO_SLIDE_DELAY = 7000;
      const TRANSITION_DURATION = 1000;

      function showSlide(index: number, direction = 'next') {
        if (isTransitioning || index === currentSlide) return;
        isTransitioning = true;

        const prevSlide = currentSlide;
        currentSlide = index;

        slides.forEach((slide, i) => {
          if (i === currentSlide) {
            slide.style.opacity = '1';
            slide.style.transform = 'translateY(0)';
            slide.style.pointerEvents = 'auto';
            slide.style.zIndex = String(totalSlides);
          } else if (i === prevSlide) {
            slide.style.opacity = '0';
            slide.style.transform = direction === 'next' ? 'translateY(-30px)' : 'translateY(30px)';
            slide.style.pointerEvents = 'none';
            slide.style.zIndex = String(totalSlides - 1);
          } else {
            slide.style.opacity = '0';
            slide.style.transform = 'translateY(30px)';
            slide.style.pointerEvents = 'none';
            slide.style.zIndex = String(totalSlides - i - 1);
          }
        });

        dots.forEach((dot, i) => {
          if (i === currentSlide) {
            dot.classList.remove('bg-white/40', 'hover:bg-white/60', 'w-2.5');
            dot.classList.add('bg-white', 'w-10');
          } else {
            dot.classList.remove('bg-white', 'w-10');
            dot.classList.add('bg-white/40', 'hover:bg-white/60', 'w-2.5');
          }
          dot.setAttribute('aria-current', i === currentSlide ? 'true' : 'false');
        });

        setTimeout(() => { isTransitioning = false; }, TRANSITION_DURATION);
      }

      function nextSlide() { showSlide((currentSlide + 1) % totalSlides, 'next'); }
      function prevSlide() { showSlide((currentSlide - 1 + totalSlides) % totalSlides, 'prev'); }

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          const direction = i > currentSlide ? 'next' : 'prev';
          showSlide(i, direction);
          resetAutoSlide();
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { nextSlide(); resetAutoSlide(); }
        else if (e.key === 'ArrowLeft') { prevSlide(); resetAutoSlide(); }
      });

      let touchStartX = 0;
      container.addEventListener('touchstart', (e: TouchEvent) => { touchStartX = e.touches[0].clientX; }, { passive: true });
      container.addEventListener('touchend', (e: TouchEvent) => {
        const touchEndX = e.changedTouches[0].clientX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 50) { if (diff > 0) nextSlide(); else prevSlide(); resetAutoSlide(); }
      }, { passive: true });

      container.addEventListener('mouseenter', () => { clearInterval(autoSlideInterval); });
      container.addEventListener('mouseleave', () => { startAutoSlide(); });

      function startAutoSlide() { clearInterval(autoSlideInterval); autoSlideInterval = window.setInterval(nextSlide, AUTO_SLIDE_DELAY); }
      function resetAutoSlide() { startAutoSlide(); }
      startAutoSlide();

      document.addEventListener('visibilitychange', () => { if (document.hidden) clearInterval(autoSlideInterval); else startAutoSlide(); });
      window.addEventListener('beforeunload', () => { clearInterval(autoSlideInterval); });
    })();
  </script>

