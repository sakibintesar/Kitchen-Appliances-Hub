---
import Layout from '../layouts/Layout.astro';
import { FAQ_PAGE as T } from '../constants/pages';
---

<Layout title={T.meta.title} description={T.meta.description}>
  <section class="mx-auto max-w-3xl px-5 pb-8 sm:pb-16 pt-6 sm:pt-12">
    <h1 class="font-display text-[clamp(32px,5vw,52px)] font-extrabold tracking-tight">{T.title}</h1>
    <p class="mt-3 text-[16px] leading-relaxed text-muted" set:html={T.introHtml} />

    <div class="mt-8 rounded-2xl border border-line bg-tile/40 px-6 sm:px-8">
      {T.items.map((item) => (
        <details class="group border-b border-line py-4 last:border-b-0">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-semibold">
            {item.q}
            <span class="shrink-0 text-muted transition group-open:rotate-45">+</span>
          </summary>
          <p class="max-w-[62ch] pb-1 pt-2.5 text-[14px] leading-relaxed text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
