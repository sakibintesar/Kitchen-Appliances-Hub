---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../constants/components';
import { ABOUT as T } from '../constants/pages';
---

<Layout title={T.meta.title} description={T.meta.description}>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-4 sm:pb-8 pt-6 md:grid-cols-[1.1fr_1fr] md:pt-12">
    <div>
      <img src={SITE.logoDark} alt={`${SITE.name} logo`} class="logo-on-light mb-6 h-16 w-16 rounded-xl" />
      <img src={SITE.logoLight} alt={`${SITE.name} logo`} class="logo-on-dark mb-6 h-16 w-16 rounded-xl" />
      <h1 class="font-display text-[clamp(36px,5vw,60px)] font-extrabold leading-[1.02] tracking-tight">
        {T.hero.title}
      </h1>
      {T.hero.paragraphs.map((p, i) => (
        <p class:list={['max-w-[52ch] text-[16px] leading-relaxed text-muted', i === 0 ? 'mt-5' : 'mt-4']}>{p}</p>
      ))}
    </div>
    <div class="overflow-hidden rounded-xl bg-neutral-100 dark:bg-neutral-800">
      <img src={T.hero.image.src} alt={T.hero.image.alt} class="aspect-[4/5] w-full object-cover" />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5">
    <div class="grid gap-4 rounded-2xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-900/50 p-4 text-center sm:grid-cols-4 sm:gap-8 sm:p-10">
      {T.numbers.map((n) => (
        <div>
          <p class="font-display text-3xl font-bold text-gold-600">{n.num}</p>
          <p class="mt-1 text-[14px] text-muted">{n.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="values" class="mx-auto max-w-6xl scroll-mt-24 px-5 pt-4 sm:pt-8">
    <div class="grid gap-5 rounded-2xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-900/50 p-4 sm:gap-10 sm:p-10 md:grid-cols-2">
      <div>
        <p class="text-[13px] font-medium text-gold-600">{T.values.eyebrow}</p>
        <h2 class="mt-3 font-display text-[clamp(24px,3vw,32px)] font-bold leading-tight tracking-tight">
          {T.values.title}
        </h2>
        <div class="mt-6 grid gap-4">
          {T.values.items.map((item) => (
            <div class="flex gap-3">
              <div class="mt-1 shrink-0 rounded-md bg-gold-100 dark:bg-gold-900/30 p-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-gold-600 dark:text-gold-400">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                  <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold">{item.title}</h3>
                <p class="mt-1 text-[14px] text-muted">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="overflow-hidden rounded-xl bg-neutral-100 dark:bg-neutral-800">
        <img src="/about/showroom.jpg" alt="KitchenHub showroom with professional appliances" class="aspect-[4/3] w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="mx-auto flex max-w-3xl flex-col items-center justify-center gap-4 px-5 py-4 sm:py-14 text-center">
    <h2 class="font-display text-2xl font-bold">{T.cta.title}</h2>
    <p class="text-[15px] text-muted">{T.cta.text}</p>
    <a href={T.cta.button.href} class="rounded-md bg-gold-600 px-6 py-3.5 text-[15px] font-semibold text-white hover:bg-gold-700">
      {T.cta.button.label}
    </a>
  </section>
</Layout>
