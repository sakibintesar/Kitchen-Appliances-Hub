// Infinite Grid Island - Figma-style infinite canvas grid with metallic/heat wave shaders
// Renders as a fixed background that creates infinite grid illusion with metallic/heat wave textures

import { Canvas } from '@react-three/fiber';
import { useFrame } from '@react-three/fiber';
import { useRef, useEffect, useMemo } from 'react';
import * as THREE from 'three';

interface InfiniteGridProps {
  className?: string;
  variant?: 'metallic' | 'heatwave' | 'carbon';
  opacity?: number;
  speed?: number;
}

export default function InfiniteGrid({ 
  className = '', 
  variant = 'metallic',
  opacity = 0.15,
  speed = 0.5
}: InfiniteGridProps) {
  const gridRef = useRef<THREE.Mesh>(null);
  const materialRef = useRef<THREE.ShaderMaterial>(null);
  const cameraRef = useRef<THREE.Camera>(null);
  const timeRef = useRef(0);

  // Shader uniforms for different variants
  const uniforms = useMemo(() => {
    const base = {
      uTime: { value: 0 },
      uSpeed: { value: speed },
      uOpacity: { value: opacity },
      uGridSize: { value: 20.0 },
      uLineWidth: { value: 0.003 },
      uColorA: { value: new THREE.Color(0xB8860B) },  // Copper
      uColorB: { value: new THREE.Color(0xFFD700) },  // Gold
    };

    switch (variant) {
      case 'heatwave':
        return {
          ...base,
          uColorA: { value: new THREE.Color(0xFF6B35) },  // Heat orange
          uColorB: { value: new THREE.Color(0xFFD700) },  // Gold
          uHeatIntensity: { value: 0.5 },
        };
      case 'carbon':
        return {
          ...base,
          uColorA: { value: new THREE.Color(0x1a1a1a) },
          uColorB: { value: new THREE.Color(0x2a2a2a) },
          uCarbonIntensity: { value: 0.3 },
        };
      default:
        return base;
    }
  }, [variant, speed, opacity]);

  const vertexShader = `
    varying vec2 vUv;
    varying vec3 vWorldPosition;
    void main() {
      vUv = uv;
      vec4 worldPos = modelMatrix * vec4(position, 1.0);
      vWorldPosition = worldPos.xyz;
      gl_Position = projectionMatrix * viewMatrix * worldPos;
    }
  `;

  const fragmentShader = `
    uniform float uTime;
    uniform float uSpeed;
    uniform float uOpacity;
    uniform float uGridSize;
    uniform float uLineWidth;
    uniform vec3 uColorA;
    uniform vec3 uColorB;
    uniform float uHeatIntensity;
    uniform float uCarbonIntensity;
    varying vec2 vUv;
    varying vec3 vWorldPosition;

    float grid(vec2 uv, float size, float lineWidth) {
      vec2 grid = fract(uv * size) - 0.5;
      float line = step(abs(grid.x), lineWidth) + step(abs(grid.y), lineWidth);
      return min(line, 1.0);
    }

    void main() {
      vec2 worldUV = vWorldPosition.xz / uGridSize;
      
      // Base grid
      float gridLines = grid(vWorldPosition.xz, 1.0, uLineWidth);
      
      // Subtle diagonal cross-hatching for metallic feel
      float diagonal1 = step(abs(mod(vWorldPosition.x + vWorldPosition.z + uTime * 0.1, 2.0) - 1.0), uLineWidth * 0.5);
      float diagonal2 = step(abs(mod(vWorldPosition.x - vWorldPosition.z - uTime * 0.08, 2.0) - 1.0), uLineWidth * 0.5);
      
      float combined = max(gridLines, max(diagonal1, diagonal2));
      
      // Color interpolation based on world position and time
      float colorMix = sin(vWorldPosition.x * 0.1 + uTime * 0.2) * 0.5 + 0.5;
      vec3 color = mix(uColorA, uColorB, colorMix);
      
      // Heat wave distortion
      float heatWave = sin(vWorldPosition.x * 0.05 + uTime * 0.5) * 0.5 + 0.5;
      vec3 finalColor = mix(color, vec3(1.0, 0.4, 0.1), heatWave * 0.3);
      
      // Carbon variant darkening
      finalColor = mix(finalColor, vec3(0.05), 0.3);
      
      float alpha = combined * uOpacity * (0.5 + 0.5 * heatWave);
      
      gl_FragColor = vec4(finalColor, alpha * 0.6);
    }
  `;

  const heatWaveFragmentShader = `
    uniform float uTime;
    uniform float uSpeed;
    uniform float uOpacity;
    uniform float uGridSize;
    uniform float uLineWidth;
    uniform vec3 uColorA;
    uniform vec3 uColorB;
    uniform float uHeatIntensity;
    varying vec2 vUv;
    varying vec3 vWorldPosition;

    float grid(vec2 uv, float size, float lineWidth) {
      vec2 grid = fract(uv * size) - 0.5;
      float line = step(abs(grid.x), lineWidth) + step(abs(grid.y), lineWidth);
      return min(line, 1.0);
    }

    // Noise function for organic heat distortion
    float noise(vec2 p) {
      return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
    }

    float fbm(vec2 p) {
      float value = 0.0;
      float amplitude = 0.5;
      for (int i = 0; i < 4; i++) {
        value += amplitude * noise(p);
        p *= 2.0;
        amplitude *= 0.5;
      }
      return value;
    }

    void main() {
      vec2 worldUV = vWorldPosition.xz / uGridSize;
      
      // Base grid with heat distortion
      float distortion = fbm(worldUV * 2.0 + uTime * 0.1) * uHeatIntensity * 0.1;
      vec2 distortedUV = worldUV + vec2(distortion, distortion * 0.5);
      
      float gridLines = grid(distortedUV, 1.0, uLineWidth);
      
      // Heat shimmer lines
      float shimmer = step(0.95, sin(vWorldPosition.y * 0.5 + uTime * 2.0)) * 0.3;
      float shimmer2 = step(0.95, sin(vWorldPosition.x * 0.3 - uTime * 1.5)) * 0.2;
      
      float combined = max(gridLines, max(shimmer, shimmer2));
      
      // Heat color gradient
      float heatMix = (sin(vWorldPosition.x * 0.2 + uTime) + 1.0) * 0.5;
      vec3 color = mix(vec3(1.0, 0.2, 0.0), vec3(1.0, 0.8, 0.0), heatMix);
      
      // Add noise for organic feel
      float noiseVal = noise(vWorldPosition.xz * 0.5 + uTime * 0.05) * 0.1;
      color += vec3(noiseVal) * 0.5;
      
      float alpha = combined * uOpacity * (0.3 + 0.7 * smoothstep(0.0, 1.0, heatMix));
      
      gl_FragColor = vec4(color, alpha);
    }
  `;

  const carbonFragmentShader = `
    uniform float uTime;
    uniform float uSpeed;
    uniform float uOpacity;
    uniform float uGridSize;
    uniform float uLineWidth;
    uniform vec3 uColorA;
    uniform vec3 uColorB;
    uniform float uCarbonIntensity;
    varying vec2 vUv;
    varying vec3 vWorldPosition;

    float grid(vec2 uv, float size, float lineWidth) {
      vec2 grid = fract(uv * size) - 0.5;
      float line = step(abs(grid.x), lineWidth) + step(abs(grid.y), lineWidth);
      return min(line, 1.0);
    }

    float noise(vec2 p) {
      return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
    }

    void main() {
      vec2 worldUV = vWorldPosition.xz / uGridSize;
      
      // Subtle carbon fiber weave pattern
      float weave1 = step(0.5, sin(vWorldPosition.x * 20.0 + uTime * 0.1));
      float weave2 = step(0.5, sin(vWorldPosition.z * 20.0 - uTime * 0.08));
      float weave = weave1 * weave2;
      
      float gridLines = grid(vWorldPosition.xz, 1.0, uLineWidth);
      float combined = max(gridLines, weave * 0.3);
      
      // Carbon fiber color - very subtle
      vec3 carbonColor = mix(vec3(0.08), vec3(0.12), sin(vWorldPosition.x * 0.1 + uTime * 0.1) * 0.5 + 0.5);
      vec3 highlight = vec3(0.15, 0.15, 0.15);
      
      vec3 finalColor = mix(carbonColor, highlight, weave * 0.5);
      
      float alpha = combined * uOpacity * 0.4 * (1.0 - uCarbonIntensity * 0.5);
      
      gl_FragColor = vec4(finalColor, alpha * 0.5);
    }
  `;

  // Select fragment shader based on variant
  const fragmentShader = variant === 'heatwave' ? heatWaveFragmentShader :
                         variant === 'carbon' ? carbonFragmentShader :
                         fragmentShader;

  return (
    <div className={`absolute inset-0 ${className}`} style={{ pointerEvents: 'none' }}>
      <Canvas
        camera={{ position: [0, 100, 100], fov: 60 }}
        style={{ width: '100%', height: '100%' }}
        onCreated={({ gl }) => {
          gl.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          gl.physicallyCorrectLights = true;
        }}
      >
        <color attach="background" args={['#0a0a0a']} />

        {/* Fog for depth */}
        <fog attach="fog" args={['#0a0a0a', 50, 300]} />

        {/* Ambient light */}
        <ambientLight intensity={0.3} color="#ffffff" />
        <directionalLight position={[100, 200, 100]} intensity={0.5} color="#ffffff" />

        {/* Infinite Grid - using custom shader for true infinite effect */}
        <InfiniteGridMesh 
          uniforms={uniforms}
          fragmentShader={fragmentShader}
        />

        {/* Subtle ambient particles */}
        <AmbientParticles count={150} />
      </Canvas>
    </div>
  );
}

// Custom infinite grid mesh with shader
function InfiniteGridMesh({ uniforms, fragmentShader }) {
  const meshRef = useRef<THREE.Mesh>(null);

  useFrame((state) => {
    const camera = state.camera;
    const mesh = meshRef.current;
    if (mesh && camera) {
      // Follow camera XZ but stay at y=0
      mesh.position.x = Math.round(camera.position.x / 20) * 20;
      mesh.position.z = Math.round(camera.position.z / 20) * 20;
      mesh.position.y = -0.01;
      
      // Update time uniform
      if (mesh.material instanceof THREE.ShaderMaterial) {
        mesh.material.uniforms.uTime.value = performance.now() * 0.001;
      }
    }
  });

  // Create shader material with custom fragment shader
  const materialRef = useRef<THREE.ShaderMaterial>(null);

  useEffect(() => {
    if (materialRef.current) {
      materialRef.current.fragmentShader = fragmentShader;
      materialRef.current.uniforms = uniforms;
      materialRef.current.needsUpdate = true;
    }
  }, [fragmentShader, uniforms]);

  return (
    <mesh ref={meshRef} rotation={[-Math.PI / 2, 0, 0]}>
      <planeGeometry args={[10000, 10000, 1, 1]} />
      <meshBasicMaterial
        ref={materialRef}
        color="#1a1a1a"
        transparent
        opacity={0.15}
        side={THREE.DoubleSide}
        depthWrite={false}
        onBeforeCompile={(shader) => {
          // Inject custom fragment shader
          shader.fragmentShader = fragmentShader;
          shader.uniforms = { ...shader.uniforms, ...uniforms };
        }}
      />
    </mesh>
  );
}

// Ambient particles for atmosphere
function AmbientParticles({ count = 150 }) {
  const pointsRef = useRef<THREE.Points>(null);

  useEffect(() => {
    const points = pointsRef.current;
    if (!points) return;

    const positions = points.geometry.attributes.position.array;
    for (let i = 0; i < count; i++) {
      positions[i * 3] = (Math.random() - 0.5) * 200;
      positions[i * 3 + 1] = Math.random() * 50;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 200;
    }
    points.geometry.attributes.position.needsUpdate = true;
  }, [count]);

  useFrame((state) => {
    const points = pointsRef.current;
    if (points) {
      points.rotation.y += 0.00002;
      points.rotation.x += 0.00001;
    }
  });

  const positions = new Float32Array(count * 3);
  for (let i = 0; i < count; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 200;
    positions[i * 3 + 1] = Math.random() * 50;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 200;
  }

  return (
    <points ref={pointsRef}>
      <bufferGeometry>
        <bufferAttribute attach="attributes-position" args={[positions, 3]} />
      </bufferGeometry>
      <pointsMaterial
        color="#B8860B"
        size={0.5}
        transparent
        opacity={0.3}
        sizeAttenuation
        transparent
        depthWrite={false}
        blending={THREE.AdditiveBlending}
      />
    </points>
  );
}

import { useFrame, useEffect, useMemo } from 'react';
import * as THREE from 'three';
</script>

