// Magnetic Fluid Cursor Island
// GSAP quickTo for 60fps magnetic cursor with premium feel
// Features: elastic follow, magnetic attraction, ripple effects, click feedback, scroll hiding

import { useEffect, useRef } from 'react';
import { gsap } from 'gsap';

export default function MagneticCursor() {
  const cursorRef = useRef<HTMLDivElement>(null);
  const followerRef = useRef<HTMLDivElement>(null);
  const rippleRef = useRef<HTMLDivElement>(null);
  
  useEffect(() => {
    if (!cursorRef.current || !followerRef.current || !rippleRef.current) return;
    
    const cursor = cursorRef.current;
    const follower = followerRef.current;
    const ripple = rippleRef.current;
    
    // Ultra-smooth interpolators using gsap.quickTo
    const xTo = gsap.quickTo(cursor, 'x', { duration: 0.12, ease: 'power3.out' });
    const yTo = gsap.quickTo(cursor, 'y', { duration: 0.12, ease: 'power3.out' });
    
    // Follower with slight lag for premium feel
    const fxTo = gsap.quickTo(follower, 'x', { duration: 0.35, ease: 'power2.out' });
    const fyTo = gsap.quickTo(follower, 'y', { duration: 0.35, ease: 'power2.out' });
    const fScaleTo = gsap.quickTo(follower, 'scale', { duration: 0.4, ease: 'elastic.out(1, 0.5)' });
    const fOpacityTo = gsap.quickTo(follower, 'opacity', { duration: 0.3 });
    
    // Ripple effect
    const rippleScaleTo = gsap.quickTo(ripple, 'scale', { duration: 0.6, ease: 'power2.out' });
    const rippleOpacityTo = gsap.quickTo(ripple, 'opacity', { duration: 0.4 });
    
    let mouseX = 0;
    let mouseY = 0;
    let isMagnetic = false;
    let magneticTarget: HTMLElement | null = null;
    let magneticRect: DOMRect | null = null;
    
    const handleMouseMove = (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      
      // Main cursor - immediate
      xTo(mouseX - 8);
      yTo(mouseY - 8);
      
      // Follower - delayed for premium feel
      fxTo(mouseX - 16);
      fyTo(mouseY - 16);
      
      // Magnetic pull calculation
      if (isMagnetic && magneticTarget && magneticRect) {
        const centerX = magneticRect.left + magneticRect.width / 2;
        const centerY = magneticRect.top + magneticRect.height / 2;
        const dx = centerX - mouseX;
        const dy = centerY - mouseY;
        const distance = Math.sqrt(dx * dx + dy * dy);
        const maxDistance = 150;
        
        if (distance < maxDistance) {
          const force = (1 - distance / maxDistance) * 0.3;
          xTo(mouseX + dx * force);
          yTo(mouseY + dy * force);
        }
      }
    };
    
    const handleMagneticEnter = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      const magneticEl = target.closest('[data-magnetic]') as HTMLElement;
      
      if (magneticEl) {
        isMagnetic = true;
        magneticTarget = magneticEl;
        magneticRect = magneticEl.getBoundingClientRect();
        
        const strength = parseFloat(magneticEl.dataset.magneticStrength || '1.5');
        const scale = parseFloat(magneticEl.dataset.magneticScale || '2');
        
        gsap.to(cursor, {
          scale: scale,
          borderColor: '#B8860B',
          backgroundColor: 'rgba(184, 134, 11, 0.15)',
          boxShadow: '0 0 40px rgba(184, 134, 11, 0.5), 0 0 80px rgba(184, 134, 11, 0.2)',
          duration: 0.3,
          ease: 'power2.out'
        });
        
        gsap.to(follower, {
          scale: scale * 1.5,
          borderColor: 'rgba(184, 134, 11, 0.6)',
          backgroundColor: 'rgba(184, 134, 11, 0.08)',
          duration: 0.4,
          ease: 'elastic.out(1, 0.5)'
        });
        
        // Ripple effect
        rippleScaleTo(0);
        rippleOpacityTo(1);
        setTimeout(() => {
          rippleScaleTo(3);
          rippleOpacityTo(0);
        }, 50);
      }
    };
    
    const handleMagneticLeave = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      const magneticEl = target.closest('[data-magnetic]');
      
      if (magneticEl && isMagnetic) {
        isMagnetic = false;
        magneticTarget = null;
        magneticRect = null;
        
        gsap.to(cursor, {
          scale: 1,
          borderColor: 'rgba(255, 255, 255, 0.6)',
          backgroundColor: 'transparent',
          boxShadow: 'none',
          duration: 0.4,
          ease: 'power2.out'
        });
        
        gsap.to(follower, {
          scale: 1,
          borderColor: 'rgba(255, 255, 255, 0.3)',
          backgroundColor: 'transparent',
          duration: 0.5,
          ease: 'elastic.out(1, 0.5)'
        });
      }
    };
    
    const handleClick = () => {
      gsap.to(cursor, {
        scale: 0.7,
        duration: 0.08,
        ease: 'power2.out',
        yoyo: true,
        repeat: 1
      });
      
      gsap.to(follower, {
        scale: 0.5,
        duration: 0.1,
        ease: 'power2.out',
        yoyo: true,
        repeat: 1
      });
      
      // Click ripple
      rippleScaleTo(0);
      rippleOpacityTo(1);
      setTimeout(() => {
        rippleScaleTo(4);
        rippleOpacityTo(0);
      }, 50);
    };
    
    const handleScroll = () => {
      // Hide cursor during scroll
      gsap.to([cursor, follower], { opacity: 0, duration: 0.15 });
      clearTimeout((cursor as any)._scrollTimeout);
      (cursor as any)._scrollTimeout = setTimeout(() => {
        gsap.to([cursor, follower], { opacity: 1, duration: 0.3 });
      }, 150);
    };
    
    window.addEventListener('mousemove', handleMouseMove, { passive: true });
    window.addEventListener('mouseover', handleMagneticEnter, { passive: true });
    window.addEventListener('mouseout', handleMagneticLeave, { passive: true });
    window.addEventListener('mousedown', handleClick, { passive: true });
    window.addEventListener('scroll', handleScroll, { passive: true });
    
    // Hide cursor when leaving window
    document.addEventListener('mouseleave', () => {
      gsap.to([cursor, follower], { opacity: 0, duration: 0.2 });
    });
    
    document.addEventListener('mouseenter', () => {
      gsap.to([cursor, follower], { opacity: 1, duration: 0.3 });
    });
    
    return () => {
      window.removeEventListener('mousemove', handleMouseMove);
      window.removeEventListener('mouseover', handleMagneticEnter);
      window.removeEventListener('mouseout', handleMagneticLeave);
      window.removeEventListener('mousedown', handleClick);
      window.removeEventListener('scroll', handleScroll);
    };
  }, []);
  
  return (
    <>
      {/* Main cursor - immediate response */}
      <div
        ref={cursorRef}
        class="fixed top-0 left-0 w-4 h-4 border-2 border-white/60 rounded-full pointer-events-none z-[9999] mix-blend-difference transition-transform will-change-transform"
        style="transform: translate(-50%, -50%)"
        aria-hidden="true"
      >
        <div class="w-full h-4 rounded-full bg-white/10" />
      </div>
      
      {/* Follower - delayed for premium feel */}
      <div
        ref={followerRef}
        class="fixed top-0 left-0 w-8 h-8 border border-white/30 rounded-full pointer-events-none z-[9998] mix-blend-difference transition-transform will-change-transform"
        style="transform: translate(-50%, -50%)"
        aria-hidden="true"
      />
      
      {/* Ripple effect on click/magnetic enter */}
      <div
        ref={rippleRef}
        class="fixed top-0 left-0 w-16 h-16 border-2 border-gold-500/50 rounded-full pointer-events-none z-[9997] opacity-0"
        style="transform: translate(-50%, -50%) scale(0)"
        aria-hidden="true"
      />
    </>
  );
}
</script>

<style>
  :host {
    display: block;
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
  }
  
  /* Reduce motion support */
  @media (prefers-reduced-motion: reduce) {
    :host {
      display: none;
    }
  }
</style>