---
import type { Product } from '../lib/commerce';
import { PRODUCT_CARD as T } from '../constants/components';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const img = product.images[0];
const onSale = !!product.compareAtPrice;
const firstAvailable = product.variants.find((v) => v.available) ?? product.variants[0];

const cartLine = JSON.stringify({
  variantId: firstAvailable?.id ?? product.id,
  productHandle: product.handle,
  title: product.title,
  variantTitle: firstAvailable?.title ?? 'Default',
  image: img,
  price: product.price,
  quantity: 1,
});
---

<a href={`/products/${product.handle}`} class="group block rounded-lg transition hover:bg-tile/60">
  <div class="relative overflow-hidden rounded-lg bg-tile">
    <div class="aspect-square">
      {img && (
        <img
          src={img.src}
          alt={img.alt}
          class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
          loading="lazy"
        />
      )}
    </div>
    {onSale && (
      <span class="absolute left-3 top-3 rounded-md bg-ink px-2.5 py-1 text-[12px] font-semibold text-paper">
        {T.saleBadge}
      </span>
    )}
    <button
      type="button"
      data-fav-toggle={product.handle}
      onclick="event.preventDefault()"
      class="absolute right-3 top-3 rounded-md bg-paper/85 p-2 text-ink shadow-sm backdrop-blur transition hover:text-pine"
      aria-label={T.ariaFav(product.title)}
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 20.5c-5.5-3.6-8.5-6.9-8.5-10.4A4.6 4.6 0 0 1 8.1 5.4c1.6 0 3 .8 3.9 2.1a4.7 4.7 0 0 1 3.9-2.1 4.6 4.6 0 0 1 4.6 4.7c0 3.5-3 6.8-8.5 10.4z" />
      </svg>
    </button>
    <button
      type="button"
      data-cart-line={cartLine}
      data-quick-add
      onclick="event.preventDefault()"
      class="absolute inset-x-3 bottom-3 translate-y-2 rounded-md bg-paper/90 py-2.5 text-[14px] font-semibold text-ink opacity-0 shadow-sm backdrop-blur transition duration-200 hover:bg-pine hover:text-white focus-visible:translate-y-0 focus-visible:opacity-100 group-hover:translate-y-0 group-hover:opacity-100"
      aria-label={T.ariaAdd(product.title)}
    >
      {T.addToCart}
    </button>
  </div>
  <div class="flex flex-col items-center justify-center gap-2 px-4 py-3">
    <h3 class="truncate text-[15px] font-medium group-hover:underline group-hover:underline-offset-4">{product.title}</h3>
    <p class="text-[18px] text-muted">
      {onSale && <s class="mr-1.5 text-[13px]">${product.compareAtPrice!.amount}</s>}
      <span class:list={[onSale && 'font-semibold text-pine']}>${product.price.amount}</span>
    </p>
  </div>
</a>
