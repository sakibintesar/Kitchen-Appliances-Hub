# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# SSLCommerz Configuration (for Bangladesh payments)
# Get these from https://www.sslcommerz.com/merchant/login
# Sandbox credentials from https://www.sslcommerz.com/merchant/login (test mode)
SSLCOMMERZ_STORE_ID=your_store_id_here
SSLCOMMERZ_STORE_PASSWORD=your_store_password_here
SSLCOMMERZ_SANDBOX=true

# WhatsApp Business API Configuration (optional - for order notifications)
# Get these from Meta Developer Console > WhatsApp > API Setup
# https://developers.facebook.com/docs/whatsapp/cloud-api/getting-started
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_API_VERSION=v20.0

# App Configuration
NODE_ENV=development
COMMERCE_PROVIDER=d1
PUBLIC_SITE_URL=http://localhost:4321